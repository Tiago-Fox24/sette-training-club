                    ` : `
                      <button disabled class="w-full py-2.5 rounded-xl bg-zinc-900/70 text-zinc-500 border border-zinc-800/70 text-xs font-medium cursor-not-allowed">
                        Indisponível
                      </button>
                    `}
                  </div>
                </div>
              `;
            }).join('')}
          </div>
        </div>
      `;
    }

    window.studentBookSlot = function (dayOfWeek, time) {
      const student = getStudentById(uiState.activeStudentId);
      const check = canBookStudentInSlot(student.id, dayOfWeek, time);
      if (!check.ok) return showToast(check.reason, 'error');
      appState.sessions.push({
        id: 'ses-' + Date.now(),
        dayOfWeek,
        time,
        studentId: student.id,
        modality: student.modality,
        status: 'agendado',
        checkinMethod: null
      });
      saveState();
      renderApp();
      showToast(`Horário reservado: ${DAYS_OF_WEEK[dayOfWeek].full} às ${time}!`, 'success');
    };

    /* ============================================================================
       14. PORTAL DO ALUNO: BIOIMPEDÂNCIA & EVOLUÇÃO CORPORAL ILUSTRADA (SVG + CHARTS)
       ============================================================================ */
    function renderStudentBioIllustrated(container) {
      const student = getStudentById(uiState.activeStudentId);
      if (!student) return;

      const history = getStudentBioHistory(student.id);
      if (history.length === 0) {
        container.innerHTML = `
          <div class="rounded-2xl bg-sette-card border border-zinc-800 p-12 text-center">
            <i data-lucide="activity" class="w-12 h-12 text-zinc-600 mx-auto mb-3"></i>
            <h3 class="font-display font-bold text-xl text-white">Nenhuma avaliação de bioimpedância ainda</h3>
            <p class="text-sm text-zinc-400 mt-2 max-w-md mx-auto">Assim que o personal Igor Feitosa registrar sua primeira bioimpedância, seu mapa corporal interativo e gráficos de evolução aparecerão aqui.</p>
          </div>
        `;
        return;
      }

      if (uiState.studentBioIndex >= history.length) uiState.studentBioIndex = 0;
      const current = history[uiState.studentBioIndex];
      const previous = history[uiState.studentBioIndex + 1] || null;
      const activeSegKey = uiState.selectedBodySegment || 'trunk';
      const curSeg = current.segments[activeSegKey];
      const prevSeg = previous ? previous.segments[activeSegKey] : null;

      // Helper para cor de cada segmento da silhueta SVG
      function getSegmentFill(segKey) {
        if (!previous) return 'rgba(16, 185, 129, 0.35)';
        const deltaMuscle = current.segments[segKey].muscle - previous.segments[segKey].muscle;
        const deltaFat = current.segments[segKey].fat - previous.segments[segKey].fat;
        if (deltaMuscle >= 0 && deltaFat <= 0) return 'rgba(16, 185, 129, 0.55)'; // Evolução positiva
        if (deltaFat > 1.0) return 'rgba(245, 158, 11, 0.50)'; // Ponto de atenção
        return 'rgba(16, 185, 129, 0.35)';
      }

      // Helper para barras semafóricas (Baixo / Ideal / Elevado)
      function renderGaugeBar(title, value, unit, min, max, idealLow, idealHigh, invertGood = false) {
        const pct = Math.max(4, Math.min(96, ((value - min) / (max - min)) * 100));
        let statusText = 'Ideal';
        let statusColor = 'text-emerald-400';
        if (value < idealLow) {
          statusText = invertGood ? 'Excelente' : 'Baixo';
          statusColor = invertGood ? 'text-emerald-400' : 'text-amber-400';
        } else if (value > idealHigh) {
          statusText = invertGood ? 'Elevado' : 'Acima';
          statusColor = invertGood ? 'text-rose-400' : 'text-emerald-400';
        }

        const lowW = ((idealLow - min) / (max - min)) * 100;
        const idealW = ((idealHigh - idealLow) / (max - min)) * 100;
        const highW = 100 - lowW - idealW;

        return `
          <div class="p-3.5 rounded-xl bg-zinc-950/80 border border-zinc-800/80">
            <div class="flex items-center justify-between mb-2">
              <span class="text-xs font-medium text-zinc-300">${title}</span>
              <div class="flex items-center gap-2">
                <span class="font-display font-bold text-base text-white">${value}${unit}</span>
                <span class="text-[11px] font-bold ${statusColor}">${statusText}</span>
              </div>
            </div>
            <div class="relative h-2.5 rounded-full overflow-hidden flex bg-zinc-800">
              <div style="width: ${lowW}%" class="${invertGood ? 'bg-emerald-500/60' : 'bg-amber-500/50'}"></div>
              <div style="width: ${idealW}%" class="bg-emerald-500/80"></div>
              <div style="width: ${highW}%" class="${invertGood ? 'bg-rose-500/70' : 'bg-emerald-400/50'}"></div>
              <div class="absolute top-0 bottom-0 w-1.5 bg-white rounded-full shadow-[0_0_8px_#fff]" style="left: calc(${pct}% - 3px)"></div>
            </div>
            <div class="flex justify-between text-[10px] text-zinc-500 mt-1">
              <span>Baixo</span>
              <span>Faixa Ideal (${idealLow}–${idealHigh}${unit})</span>
              <span>Elevado</span>
            </div>
          </div>
        `;
      }

      const isMale = student.gender === 'M';
      const deltaMuscleSeg = prevSeg ? (curSeg.muscle - prevSeg.muscle).toFixed(1) : null;
      const deltaFatSeg = prevSeg ? (curSeg.fat - prevSeg.fat).toFixed(1) : null;

      container.innerHTML = `
        <div class="space-y-6">
          <!-- Topo com Seletor de Avaliação -->
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div>
              <h2 class="text-2xl font-display font-bold text-white">Bioimpedância & Evolução Corporal</h2>
              <p class="text-sm text-zinc-400">Clique nas regiões do corpo para explorar sua evolução muscular e de gordura.</p>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-xs text-zinc-400">Avaliação:</span>
              <select onchange="changeStudentBioIndex(this.value)" class="bg-sette-card border border-emerald-500/40 rounded-xl px-3.5 py-2 text-sm text-white focus:outline-none">
                ${history.map((h, idx) => `
                  <option value="${idx}" ${idx === uiState.studentBioIndex ? 'selected' : ''}>
                    ${new Date(h.date + 'T12:00:00').toLocaleDateString('pt-BR')} ${idx === 0 ? '(Mais recente)' : ''}
                  </option>
                `).join('')}
              </select>
            </div>
          </div>

          <!-- Feedback do Personal Igor Feitosa -->
          <div class="rounded-2xl bg-gradient-to-r from-emerald-950/40 via-zinc-900 to-zinc-900 border border-emerald-500/35 p-5 flex flex-col sm:flex-row gap-4 items-start">
            <div class="w-12 h-12 rounded-2xl bg-emerald-500 text-zinc-950 font-display font-bold flex items-center justify-center shrink-0 text-base shadow-lg shadow-emerald-950/50">
              IF
            </div>
            <div class="flex-1">
              <div class="flex items-center gap-2 flex-wrap">
                <h3 class="font-display font-bold text-base text-white">Análise do Personal Igor Feitosa</h3>
                <span class="px-2 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-500/15 text-emerald-300 border border-emerald-500/30">
                  Avaliação de ${new Date(current.date + 'T12:00:00').toLocaleDateString('pt-BR')}
                </span>
              </div>
              <p class="text-sm text-zinc-200 mt-2 leading-relaxed">"${current.feedback}"</p>
            </div>
          </div>

          <!-- Silhueta Corporal Interativa + Indicadores Semafóricos -->
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
            <!-- Silhueta Anatômica Interativa (5 cols) -->
            <div class="lg:col-span-5 rounded-2xl bg-sette-card border border-zinc-800/90 p-5 flex flex-col justify-between">
              <div class="flex items-center justify-between mb-2">
                <div>
                  <h3 class="font-display font-bold text-base text-white">Mapa Corporal Segmentar</h3>
                  <p class="text-xs text-zinc-400">Toque em braços, tronco ou pernas</p>
                </div>
                <span class="px-2 py-1 rounded-lg bg-emerald-500/10 text-emerald-400 text-[11px] font-semibold border border-emerald-500/20">Interativo</span>
              </div>

              <!-- SVG Anatômico Interativo -->
              <div class="relative flex items-center justify-center my-2">
                <svg viewBox="0 0 240 360" class="w-56 sm:w-64 h-auto select-none" role="img" aria-label="Silhueta Corporal Interativa">
                  <!-- Cabeça e Pescoço (decorativos) -->
                  <circle cx="120" cy="36" r="21" fill="#27272a" stroke="#52525b" stroke-width="1.5" />
                  <rect x="111" y="56" width="18" height="14" rx="4" fill="#27272a" stroke="#52525b" stroke-width="1.2" />

                  <!-- Braço Direito (lado esquerdo da tela — visão frontal anatômica) -->
                  <path
                    onclick="selectBodySegment('rightArm')"
                    class="body-segment ${activeSegKey === 'rightArm' ? 'active-segment' : ''}"
                    d="M78 76 C64 78 54 92 48 124 L36 184 C34 194 42 200 50 197 L66 144 L76 112 Z"
                    fill="${getSegmentFill('rightArm')}"
                    stroke="#10b981"
                    stroke-width="1.5"
                  />

                  <!-- Braço Esquerdo (lado direito da tela) -->
                  <path
                    onclick="selectBodySegment('leftArm')"
                    class="body-segment ${activeSegKey === 'leftArm' ? 'active-segment' : ''}"
                    d="M162 76 C176 78 186 92 192 124 L204 184 C206 194 198 200 190 197 L174 144 L164 112 Z"
                    fill="${getSegmentFill('leftArm')}"
                    stroke="#10b981"
                    stroke-width="1.5"
                  />

                  <!-- Tronco / Core -->
                  <path
                    onclick="selectBodySegment('trunk')"
                    class="body-segment ${activeSegKey === 'trunk' ? 'active-segment' : ''}"
                    d="M80 72 L160 72 L164 112 L152 178 C151 190 146 198 120 198 C94 198 89 190 88 178 L76 112 Z"
                    fill="${getSegmentFill('trunk')}"
                    stroke="#10b981"
                    stroke-width="1.5"
                  />

                  <!-- Perna Direita (lado esquerdo da tela) -->
                  <path
                    onclick="selectBodySegment('rightLeg')"
                    class="body-segment ${activeSegKey === 'rightLeg' ? 'active-segment' : ''}"
                    d="M86 198 L117 202 L112 276 L104 338 C102 346 86 346 84 338 L78 272 Z"
                    fill="${getSegmentFill('rightLeg')}"
                    stroke="#10b981"
                    stroke-width="1.5"
                  />

                  <!-- Perna Esquerda (lado direito da tela) -->
                  <path
                    onclick="selectBodySegment('leftLeg')"
                    class="body-segment ${activeSegKey === 'leftLeg' ? 'active-segment' : ''}"
                    d="M154 198 L123 202 L128 276 L136 338 C138 346 154 346 156 338 L162 272 Z"
                    fill="${getSegmentFill('leftLeg')}"
                    stroke="#10b981"
                    stroke-width="1.5"
                  />

                  <!-- Pontos indicadores discretos -->
                  <circle cx="52" cy="138" r="4" fill="#fff" class="pointer-events-none opacity-80"/>
                  <circle cx="188" cy="138" r="4" fill="#fff" class="pointer-events-none opacity-80"/>
                  <circle cx="120" cy="132" r="5" fill="#fff" class="pointer-events-none opacity-90"/>
                  <circle cx="96" cy="264" r="4" fill="#fff" class="pointer-events-none opacity-80"/>
                  <circle cx="144" cy="264" r="4" fill="#fff" class="pointer-events-none opacity-80"/>
                </svg>
              </div>

              <!-- Detalhe do Segmento Selecionado -->
              <div class="rounded-xl bg-zinc-950 border border-emerald-500/35 p-4 mt-2">
                <div class="flex items-center justify-between mb-2">
                  <span class="text-xs font-bold uppercase tracking-wider text-emerald-400">${SEGMENT_LABELS[activeSegKey]}</span>
                  <div class="flex gap-1">
                    ${Object.keys(SEGMENT_LABELS).map(k => `
                      <button onclick="selectBodySegment('${k}')" title="${SEGMENT_LABELS[k]}" class="w-2.5 h-2.5 rounded-full transition ${activeSegKey === k ? 'bg-emerald-400 scale-125' : 'bg-zinc-700 hover:bg-zinc-500'}"></button>
                    `).join('')}
                  </div>
                </div>
                <div class="grid grid-cols-2 gap-3">
                  <div class="p-2.5 rounded-lg bg-zinc-900/90 border border-zinc-800">
                    <span class="text-[10px] uppercase text-zinc-400 block">Massa Magra</span>
                    <span class="font-display font-bold text-xl text-white">${curSeg.muscle} kg</span>
                    ${deltaMuscleSeg !== null ? `
                      <span class="block text-[11px] font-semibold mt-0.5 ${Number(deltaMuscleSeg) >= 0 ? 'text-emerald-400' : 'text-amber-400'}">
                        ${Number(deltaMuscleSeg) >= 0 ? '▲ +' : '▼ '}${deltaMuscleSeg} kg vs anterior
                      </span>
                    ` : '<span class="block text-[10px] text-zinc-500 mt-0.5">Avaliação base</span>'}
                  </div>
                  <div class="p-2.5 rounded-lg bg-zinc-900/90 border border-zinc-800">
                    <span class="text-[10px] uppercase text-zinc-400 block">Gordura Segmentar</span>
                    <span class="font-display font-bold text-xl text-white">${curSeg.fat}%</span>
                    ${deltaFatSeg !== null ? `
                      <span class="block text-[11px] font-semibold mt-0.5 ${Number(deltaFatSeg) <= 0 ? 'text-emerald-400' : 'text-amber-400'}">
                        ${Number(deltaFatSeg) <= 0 ? '▼ ' : '▲ +'}${deltaFatSeg}% vs anterior
                      </span>
                    ` : '<span class="block text-[10px] text-zinc-500 mt-0.5">Avaliação base</span>'}
                  </div>
                </div>
              </div>
            </div>

            <!-- Indicadores Semafóricos (7 cols) -->
            <div class="lg:col-span-7 space-y-4">
              <div class="rounded-2xl bg-sette-card border border-zinc-800/90 p-5 space-y-3">
                <div class="flex items-center justify-between mb-1">
                  <div>
                    <h3 class="font-display font-bold text-base text-white">Indicadores de Saúde & Performance</h3>
                    <p class="text-xs text-zinc-400">Leitura intuitiva estilo semáforo das suas métricas principais</p>
                  </div>
                  <div class="text-right">
                    <span class="text-[10px] uppercase text-zinc-500 block">Idade Metabólica</span>
                    <span class="font-display font-bold text-lg text-emerald-400">${current.metabolicAge} anos</span>
                  </div>
                </div>

                ${renderGaugeBar('% de Gordura Corporal', current.bodyFat, '%', 8, 40, isMale ? 12 : 18, isMale ? 20 : 26, true)}
                ${renderGaugeBar('Massa Muscular Esquelética', current.muscleMass, ' kg', 18, 48, isMale ? 33 : 23, isMale ? 42 : 30, false)}
                ${renderGaugeBar('Gordura Visceral (Nível)', current.visceralFat, '', 1, 18, 1, 9, true)}
                ${renderGaugeBar('Água Corporal Total', current.bodyWater, '%', 42, 68, isMale ? 55 : 50, isMale ? 65 : 60, false)}

                <div class="p-3.5 rounded-xl bg-zinc-950/80 border border-zinc-800/80 flex items-center justify-between">
                  <div>
                    <span class="text-xs font-medium text-zinc-300">Taxa Metabólica Basal (TMB)</span>
                    <p class="text-[11px] text-zinc-500">Energia que seu corpo consome em repouso por dia</p>
                  </div>
                  <span class="font-display font-bold text-xl text-amber-400">${current.bmr} <span class="text-xs font-normal text-zinc-400">kcal</span></span>
                </div>
              </div>
            </div>
          </div>

          <!-- Gráfico Comparativo de Recomposição Corporal -->
          <div class="rounded-2xl bg-sette-card border border-zinc-800/90 p-5">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-4">
              <div>
                <h3 class="font-display font-bold text-lg text-white">Curva de Recomposição Corporal</h3>
                <p class="text-xs text-zinc-400">Compare Peso Total × Massa Muscular × Massa Gorda (kg) ao longo das avaliações.</p>
              </div>
            </div>
            <div class="h-72">
              <canvas id="studentBioEvolutionChart"></canvas>
            </div>
          </div>
        </div>
      `;

      initStudentBioChart(history);
    }

    function initStudentBioChart(historyDesc) {
      const canvas = document.getElementById('studentBioEvolutionChart');
      if (!canvas) return;
      const ordered = [...historyDesc].reverse();

      const labels = ordered.map(h => new Date(h.date + 'T12:00:00').toLocaleDateString('pt-BR', { day: '2-digit', month: 'short' }));
      const weightData = ordered.map(h => h.weight);
      const muscleData = ordered.map(h => h.muscleMass);
      const fatKgData = ordered.map(h => Number(((h.weight * h.bodyFat) / 100).toFixed(1)));

      activeCharts.studentBio = new Chart(canvas, {
        type: 'line',
        data: {
          labels,
          datasets: [
            {
              label: 'Peso Total (kg)',
              data: weightData,
              borderColor: '#e4e4e7',
              backgroundColor: 'rgba(228, 228, 231, 0.08)',
              borderWidth: 2.5,
              tension: 0.35,
              pointRadius: 4
            },
            {
              label: 'Massa Muscular (kg)',
              data: muscleData,
              borderColor: '#10b981',
              backgroundColor: 'rgba(16, 185, 129, 0.14)',
              fill: true,
              borderWidth: 3,
              tension: 0.35,
              pointRadius: 5
            },
            {
              label: 'Massa Gorda (kg)',
              data: fatKgData,
              borderColor: '#f59e0b',
              backgroundColor: 'rgba(245, 158, 11, 0.10)',
              fill: true,
              borderWidth: 2.5,
              tension: 0.35,
              pointRadius: 4
            }
          ]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          interaction: { mode: 'index', intersect: false },
          plugins: {
            legend: {
              position: 'top',
              labels: { color: '#e4e4e7', usePointStyle: true, padding: 16 }
            },
            tooltip: {
              backgroundColor: '#18181b',
              borderColor: '#3f3f46',
              borderWidth: 1,
              padding: 10
            }
          },
          scales: {
            x: { ticks: { color: '#a1a1aa' }, grid: { color: 'rgba(39,39,42,0.5)' } },
            y: { ticks: { color: '#a1a1aa' }, grid: { color: 'rgba(39,39,42,0.5)' } }
          }
        }
      });
    }

    window.selectBodySegment = function (segKey) {
      uiState.selectedBodySegment = segKey;
      renderApp();
    };

    window.changeStudentBioIndex = function (idx) {
      uiState.studentBioIndex = Number(idx);
      renderApp();
    };

    /* ============================================================================
       15. INICIALIZAÇÃO SEGURA
       ============================================================================ */
    window.addEventListener('DOMContentLoaded', () => {
      loadState();
      renderApp();
    });
  </script>
</body>
</html>
