    /**
     * Carrega estado do localStorage com fallback seguro.
     */
    function loadState() {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (raw) {
          const parsed = JSON.parse(raw);
          if (parsed && Array.isArray(parsed.students) && Array.isArray(parsed.sessions)) {
            appState = parsed;
            return;
          }
        }
      } catch (err) {
        console.error('Erro ao carregar localStorage:', err);
      }
      appState = createDemoData();
      saveState();
    }

    /**
     * Persiste estado no localStorage.
     */
    function saveState() {
      try {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(appState));
      } catch (err) {
        console.error('Erro ao salvar localStorage:', err);
        showToast('Não foi possível salvar no armazenamento local.', 'error');
      }
    }

    /* ============================================================================
       3. FUNÇÕES UTILITÁRIAS E REGRAS DE NEGÓCIO
       ============================================================================ */
    function formatBRL(value) {
      return Number(value || 0).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
    }

    function getInitials(name) {
      if (!name) return 'ST';
      const parts = name.trim().split(/\s+/);
      return (parts[0][0] + (parts.length > 1 ? parts[parts.length - 1][0] : '')).toUpperCase();
    }

    function getStudentById(id) {
      return appState.students.find(s => s.id === id) || null;
    }

    function getComboById(id) {
      return appState.combos.find(c => c.id === id) || null;
    }

    function getComboMembers(comboId) {
      if (!comboId) return [];
      return appState.students.filter(s => s.comboId === comboId && s.status === 'ativo');
    }

    /**
     * Calcula créditos semanais usados e disponíveis de um aluno.
     * Regra: Sessões com status 'agendado', 'presente' ou 'no_show' consomem crédito.
     * Sessões com 'falta_justificada' DEVOLVEM o crédito semanal!
     */
    function getStudentWeeklyCredits(studentId) {
      const student = getStudentById(studentId);
      if (!student) return { limit: 0, used: 0, remaining: 0, justifiedReturned: 0 };
      const limit = Number(student.frequency) || 2;
      const mySessions = appState.sessions.filter(s => s.studentId === studentId);
      const consumed = mySessions.filter(s => s.status !== 'falta_justificada').length;
      const justifiedReturned = mySessions.filter(s => s.status === 'falta_justificada').length;
      return {
        limit,
        used: consumed,
        remaining: Math.max(0, limit - consumed),
        justifiedReturned
      };
    }

    /**
     * Analisa um slot de dia+horário conforme as travas exatas do portfólio.
     */
    function analyzeSlot(dayOfWeek, time) {
      const slotSessions = appState.sessions.filter(
        s => s.dayOfWeek === dayOfWeek && s.time === time && s.status !== 'falta_justificada'
      );
      const allSlotSessions = appState.sessions.filter(
        s => s.dayOfWeek === dayOfWeek && s.time === time
      );

      const personalSession = slotSessions.find(s => s.modality === 'PERSONAL_INDIVIDUAL');
      if (personalSession) {
        return {
          occupied: 1,
          capacity: 1,
          isExclusive: true,
          activeModality: 'PERSONAL_INDIVIDUAL',
          isFull: true,
          sessions: allSlotSessions,
          activeSessions: slotSessions
        };
      }

      const activeModality = slotSessions.length > 0 ? slotSessions[0].modality : null;
      const capacity = activeModality ? MODALITIES[activeModality].maxCapacity : 4;
      return {
        occupied: slotSessions.length,
        capacity,
        isExclusive: false,
        activeModality,
        isFull: slotSessions.length >= capacity,
        sessions: allSlotSessions,
        activeSessions: slotSessions
      };
    }

    /**
     * Valida se um aluno pode ser agendado em um determinado dia/horário.
     */
    function canBookStudentInSlot(studentId, dayOfWeek, time) {
      const student = getStudentById(studentId);
      if (!student) return { ok: false, reason: 'Aluno não encontrado.' };

      const alreadyHere = appState.sessions.find(
        s => s.dayOfWeek === dayOfWeek && s.time === time && s.studentId === studentId && s.status !== 'falta_justificada'
      );
      if (alreadyHere) return { ok: false, reason: 'Aluno já está agendado neste horário.' };

      const credits = getStudentWeeklyCredits(studentId);
      if (credits.remaining <= 0) {
        return { ok: false, reason: `Limite semanal atingido (${credits.used}/${credits.limit} créditos).` };
      }

      const slot = analyzeSlot(dayOfWeek, time);
      if (slot.isExclusive) {
        return { ok: false, reason: 'Horário bloqueado por Personal Individual (1/1 exclusivo).' };
      }

      if (student.modality === 'PERSONAL_INDIVIDUAL') {
        if (slot.occupied > 0) {
          return { ok: false, reason: 'Personal Individual exige horário exclusivo (já há grupo neste horário).' };
        }
        return { ok: true };
      }

      // Modalidades em grupo (Sette Fight ou Performance Sette)
      if (slot.activeModality && slot.activeModality !== student.modality) {
        return {
          ok: false,
          reason: `Horário reservado para ${MODALITIES[slot.activeModality].label}.`
        };
      }

      if (slot.occupied >= MODALITIES[student.modality].maxCapacity) {
        return {
          ok: false,
          reason: `Turma lotada (${slot.occupied}/${MODALITIES[student.modality].maxCapacity} vagas).`
        };
      }

      return { ok: true };
    }

    /**
     * Calcula estatísticas de assiduidade combinando histórico + semana atual.
     */
    function getStudentAttendanceMetrics(student) {
      const hist = student.historyStats || { attended: 0, justified: 0, noShow: 0 };
      const weekSessions = appState.sessions.filter(s => s.studentId === student.id);
      const weekAttended = weekSessions.filter(s => s.status === 'presente').length;
      const weekJustified = weekSessions.filter(s => s.status === 'falta_justificada').length;
      const weekNoShow = weekSessions.filter(s => s.status === 'no_show').length;
      const weekScheduled = weekSessions.filter(s => s.status === 'agendado').length;

      const attended = hist.attended + weekAttended;
      const justified = hist.justified + weekJustified;
      const noShow = hist.noShow + weekNoShow;
      // Índice de constância considera presenças sobre aulas efetivadas (presenças + no-shows + metade das justificadas como peso suave, ou presenças / (presenças + noShow + justified))
      const totalConcluded = attended + justified + noShow;
      const rate = totalConcluded > 0 ? Math.round((attended / totalConcluded) * 100) : 100;

      let level = 'green';
      let label = 'Excelente';
      if (rate < 60) {
        level = 'red';
        label = 'Risco de Evasão';
      } else if (rate < 80) {
        level = 'amber';
        label = 'Atenção';
      }

      return {
        attended,
        justified,
        noShow,
        scheduled: weekScheduled,
        totalConcluded,
        rate,
        level,
        label
      };
    }

    /**
     * Retorna avaliações de bioimpedância do aluno ordenadas da mais recente para a mais antiga.
     */
    function getStudentBioHistory(studentId) {
      return appState.bioimpedance
        .filter(b => b.studentId === studentId)
        .sort((a, b) => new Date(b.date) - new Date(a.date));
    }

    /**
     * Calcula alertas de combos com número de integrantes divergente do tamanho contratado.
     */
    function getComboAlerts() {
      return appState.combos
        .map(combo => {
          const members = getComboMembers(combo.id);
          return { combo, members, diff: members.length - combo.targetSize };
        })
        .filter(item => item.diff !== 0);
    }

    /**
     * Gera um padrão SVG estilo QR Code determinístico baseado no PIN diário.
     */
    function generateQrSvg(seedText) {
      const size = 15;
      let hash = 2166136261;
      for (let i = 0; i < seedText.length; i++) {
        hash ^= seedText.charCodeAt(i);
        hash += (hash << 1) + (hash << 4) + (hash << 7) + (hash << 8) + (hash << 24);
      }
      let rects = '';
      for (let y = 0; y < size; y++) {
        for (let x = 0; x < size; x++) {
          const isFinder =
            (x < 5 && y < 5) || (x >= size - 5 && y < 5) || (x < 5 && y >= size - 5);
          let fill = false;
          if (isFinder) {
            const lx = x < 5 ? x : x - (size - 5);
            const ly = y < 5 ? y : y - (size - 5);
            fill = lx === 0 || lx === 4 || ly === 0 || ly === 4 || (lx === 2 && ly === 2);
          } else {
            const bit = Math.abs(Math.sin((x + 1) * 12.9898 + (y + 1) * 78.233 + hash) * 43758.5453);
            fill = (bit - Math.floor(bit)) > 0.48;
          }
          if (fill) {
            rects += `<rect x="${x + 1}" y="${y + 1}" width="0.92" height="0.92" rx="0.15" fill="#09090b" />`;
          }
        }
      }
      return `<svg viewBox="0 0 ${size + 2} ${size + 2}" class="w-full h-full bg-white rounded-xl p-1.5" aria-label="QR Code Check-in">${rects}</svg>`;
    }

    /* ============================================================================
       4. TOASTS E MODAIS CUSTOMIZADOS (SEM ALERT/CONFIRM)
       ============================================================================ */
    function showToast(message, type = 'success') {
      const container = document.getElementById('toastContainer');
      const id = 'toast-' + Date.now() + Math.random().toString(36).slice(2, 6);
      const styles = {
        success: 'bg-zinc-900 border-emerald-500/50 text-emerald-300',
        error: 'bg-zinc-900 border-rose-500/50 text-rose-300',
        warning: 'bg-zinc-900 border-amber-500/50 text-amber-300',
        info: 'bg-zinc-900 border-zinc-700 text-zinc-200'
      };
      const icons = {
        success: 'check-circle-2',
        error: 'alert-octagon',
        warning: 'alert-triangle',
        info: 'info'
      };

      const el = document.createElement('div');
      el.id = id;
      el.className = `pointer-events-auto toast-enter flex items-center gap-3 px-4 py-3 rounded-xl border shadow-2xl ${styles[type] || styles.info}`;
      el.innerHTML = `
        <i data-lucide="${icons[type] || icons.info}" class="w-5 h-5 shrink-0"></i>
        <p class="text-xs sm:text-sm font-medium text-zinc-100 leading-snug flex-1">${message}</p>
        <button onclick="document.getElementById('${id}')?.remove()" class="text-zinc-500 hover:text-white">
          <i data-lucide="x" class="w-4 h-4"></i>
        </button>
      `;
      container.appendChild(el);
      lucide.createIcons({ root: el });
      setTimeout(() => {
        el.style.opacity = '0';
        el.style.transition = 'opacity 0.25s ease';
        setTimeout(() => el.remove(), 250);
      }, 4200);
    }

    function openModal(htmlContent, maxWidthClass = 'max-w-2xl') {
      const backdrop = document.getElementById('modalBackdrop');
      const content = document.getElementById('modalContent');
      content.className = `w-full ${maxWidthClass} bg-zinc-900 border border-zinc-800 rounded-2xl shadow-2xl overflow-hidden my-auto max-h-[92vh] flex flex-col`;
      content.innerHTML = htmlContent;
      backdrop.classList.remove('hidden');
      lucide.createIcons({ root: content });
    }

    function closeModal() {
      document.getElementById('modalBackdrop').classList.add('hidden');
    }

    document.getElementById('modalBackdrop').addEventListener('click', (e) => {
      if (e.target.id === 'modalBackdrop') closeModal();
    });

    function openConfirmModal(title, description, confirmLabel, onConfirm, danger = true) {
      window.__pendingConfirmAction = onConfirm;
      openModal(`
        <div class="p-6">
          <div class="flex items-start gap-4">
            <div class="w-11 h-11 rounded-xl ${danger ? 'bg-rose-500/15 text-rose-400 border-rose-500/30' : 'bg-amber-500/15 text-amber-400 border-amber-500/30'} border flex items-center justify-center shrink-0">
              <i data-lucide="alert-triangle" class="w-5 h-5"></i>
            </div>
            <div>
              <h3 class="text-lg font-display font-bold text-white">${title}</h3>
              <p class="text-sm text-zinc-400 mt-1.5 leading-relaxed">${description}</p>
            </div>
          </div>
          <div class="flex items-center justify-end gap-2 mt-6 pt-4 border-t border-zinc-800">
            <button onclick="closeModal()" class="px-4 py-2 rounded-xl bg-zinc-800 hover:bg-zinc-700 text-zinc-200 text-sm font-medium transition">Cancelar</button>
            <button onclick="executePendingConfirm()" class="px-4 py-2 rounded-xl ${danger ? 'bg-rose-600 hover:bg-rose-500' : 'bg-amber-500 hover:bg-amber-400 text-zinc-950'} text-white text-sm font-semibold transition">${confirmLabel}</button>
          </div>
        </div>
      `, 'max-w-md');
    }

    window.executePendingConfirm = function () {
      const fn = window.__pendingConfirmAction;
      closeModal();
      if (typeof fn === 'function') fn();
    };

    /* ============================================================================
       5. CONTROLE DE NAVEGAÇÃO, BACKUP E RESET
       ============================================================================ */
    window.switchMode = function (mode) {
      uiState.mode = mode;
      if (mode === 'student' && !getStudentById(uiState.activeStudentId) && appState.students.length > 0) {
        uiState.activeStudentId = appState.students[0].id;
      }
      renderApp();
    };

    window.changeActiveStudent = function (studentId) {
      uiState.activeStudentId = studentId;
      uiState.studentBioIndex = 0;
      renderApp();
    };

    window.setPersonalTab = function (tab) {
      uiState.personalTab = tab;
      renderApp();
    };

    window.setStudentTab = function (tab) {
      uiState.studentTab = tab;
      renderApp();
    };

    window.exportBackupJSON = function () {
      try {
        const blob = new Blob([JSON.stringify(appState, null, 2)], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `sette-training-club-backup-${new Date().toISOString().slice(0, 10)}.json`;
        document.body.appendChild(a);
        a.click();
        a.remove();
        URL.revokeObjectURL(url);
        showToast('Backup JSON exportado com sucesso!', 'success');
      } catch (err) {
        showToast('Erro ao exportar backup JSON.', 'error');
      }
    };

    window.requestResetDemo = function () {
      openConfirmModal(
        'Restaurar dados de demonstração?',
        'Todos os cadastros, agendamentos e avaliações editados localmente serão substituídos pelos dados iniciais da Sette Training Club.',
        'Restaurar Demo',
        () => {
          appState = createDemoData();
          saveState();
          uiState.activeStudentId = appState.students[0].id;
          uiState.bioSelectedStudentId = appState.students[0].id;
          renderApp();
          showToast('Dados de demonstração restaurados!', 'info');
        },
        false
      );
    };

    function destroyAllCharts() {
      Object.values(activeCharts).forEach(chart => {
        if (chart && typeof chart.destroy === 'function') chart.destroy();
      });
      activeCharts = {};
    }

    /* ============================================================================
       6. RENDERIZAÇÃO PRINCIPAL DO HEADER E NAVEGAÇÃO
       ============================================================================ */
    function renderHeaderControls() {
      const btnPersonal = document.getElementById('btnModePersonal');
      const btnStudent = document.getElementById('btnModeStudent');
      const selectorWrap = document.getElementById('studentSelectorWrapper');
      const selectEl = document.getElementById('activeStudentSelect');

      if (uiState.mode === 'personal') {
        btnPersonal.className = 'flex-1 sm:flex-initial flex items-center justify-center gap-2 px-3 py-1.5 rounded-lg text-xs sm:text-sm font-semibold bg-emerald-500 text-zinc-950 shadow-sm transition';
        btnStudent.className = 'flex-1 sm:flex-initial flex items-center justify-center gap-2 px-3 py-1.5 rounded-lg text-xs sm:text-sm font-medium text-zinc-400 hover:text-white transition';
        selectorWrap.classList.add('hidden');
      } else {
        btnPersonal.className = 'flex-1 sm:flex-initial flex items-center justify-center gap-2 px-3 py-1.5 rounded-lg text-xs sm:text-sm font-medium text-zinc-400 hover:text-white transition';
        btnStudent.className = 'flex-1 sm:flex-initial flex items-center justify-center gap-2 px-3 py-1.5 rounded-lg text-xs sm:text-sm font-semibold bg-emerald-500 text-zinc-950 shadow-sm transition';
        selectorWrap.classList.remove('hidden');
      }

      selectEl.innerHTML = appState.students
        .map(s => `<option value="${s.id}" ${s.id === uiState.activeStudentId ? 'selected' : ''}>${s.name} • ${MODALITIES[s.modality].label}</option>`)
        .join('');

      const navEl = document.getElementById('moduleNav');
      const comboAlertsCount = getComboAlerts().length;
      const churnCount = appState.students.filter(s => getStudentAttendanceMetrics(s).level === 'red').length;

      if (uiState.mode === 'personal') {
        const tabs = [
          { id: 'dashboard', label: 'Dashboard', icon: 'layout-dashboard' },
          { id: 'students', label: 'Alunos & Combos', icon: 'users', badge: comboAlertsCount > 0 ? comboAlertsCount : null, badgeColor: 'bg-amber-500 text-zinc-950' },
          { id: 'schedule', label: 'Agenda & Presença', icon: 'calendar-check-2' },
          { id: 'reports', label: 'Relatório de Faltas', icon: 'bar-chart-3', badge: churnCount > 0 ? churnCount : null, badgeColor: 'bg-rose-500 text-white' },
          { id: 'bio', label: 'Bioimpedância', icon: 'activity' }
        ];
        navEl.innerHTML = tabs.map(t => `
          <button onclick="setPersonalTab('${t.id}')" class="shrink-0 flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs sm:text-sm font-medium transition border ${
            uiState.personalTab === t.id
              ? 'bg-zinc-800/90 text-white border-zinc-700 shadow-sm'
              : 'bg-transparent text-zinc-400 border-transparent hover:text-zinc-200 hover:bg-zinc-900'
          }">
            <i data-lucide="${t.icon}" class="w-4 h-4 ${uiState.personalTab === t.id ? 'text-emerald-400' : ''}"></i>
            <span>${t.label}</span>
            ${t.badge ? `<span class="px-1.5 py-0.5 text-[10px] font-bold rounded-full ${t.badgeColor}">${t.badge}</span>` : ''}
          </button>
        `).join('');
      } else {
        const tabs = [
          { id: 'summary', label: 'Meu Resumo & Check-in', icon: 'sparkles' },
          { id: 'booking', label: 'Agendar Horário', icon: 'calendar-plus' },
          { id: 'bio', label: 'Bioimpedância Ilustrada', icon: 'heart-pulse' }
        ];
        navEl.innerHTML = tabs.map(t => `
          <button onclick="setStudentTab('${t.id}')" class="shrink-0 flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs sm:text-sm font-medium transition border ${
            uiState.studentTab === t.id
              ? 'bg-zinc-800/90 text-white border-zinc-700 shadow-sm'
              : 'bg-transparent text-zinc-400 border-transparent hover:text-zinc-200 hover:bg-zinc-900'
          }">
            <i data-lucide="${t.icon}" class="w-4 h-4 ${uiState.studentTab === t.id ? 'text-emerald-400' : ''}"></i>
            <span>${t.label}</span>
          </button>
        `).join('');
      }
    }

    function renderApp() {
      destroyAllCharts();
      renderHeaderControls();
      const main = document.getElementById('appMain');

      if (uiState.mode === 'personal') {
        if (uiState.personalTab === 'dashboard') renderPersonalDashboard(main);
        else if (uiState.personalTab === 'students') renderPersonalStudentsAndCombos(main);
        else if (uiState.personalTab === 'schedule') renderPersonalSchedule(main);
        else if (uiState.personalTab === 'reports') renderPersonalReports(main);
        else if (uiState.personalTab === 'bio') renderPersonalBioForm(main);
      } else {
        if (uiState.studentTab === 'summary') renderStudentSummary(main);
        else if (uiState.studentTab === 'booking') renderStudentBooking(main);
        else if (uiState.studentTab === 'bio') renderStudentBioIllustrated(main);
      }

      lucide.createIcons();
    }

    /* ============================================================================
       7. MÓDULO PERSONAL: DASHBOARD GERENCIAL
       ============================================================================ */
    function renderPersonalDashboard(container) {
      const activeStudents = appState.students.filter(s => s.status === 'ativo');
      const totalMRR = activeStudents.reduce(
        (sum, s) => sum + calculateMonthlyPrice(s.modality, s.frequency, s.cycle, s.groupSize),
        0
      );
      const metricsList = activeStudents.map(s => ({ student: s, metrics: getStudentAttendanceMetrics(s) }));
      const avgAttendance = metricsList.length
        ? Math.round(metricsList.reduce((acc, m) => acc + m.metrics.rate, 0) / metricsList.length)
        : 0;
      const churnRisks = metricsList.filter(m => m.metrics.level === 'red');
      const comboAlerts = getComboAlerts();

      // Sessões do dia selecionado
      const daySessions = appState.sessions
        .filter(s => s.dayOfWeek === uiState.selectedDay)
        .sort((a, b) => a.time.localeCompare(b.time));

      // Agrupar sessões do dia por horário
      const groupedByTime = {};
      daySessions.forEach(s => {
        if (!groupedByTime[s.time]) groupedByTime[s.time] = [];
        groupedByTime[s.time].push(s);
      });

      container.innerHTML = `
        <div class="space-y-6">
          <!-- Cabeçalho de Boas-Vindas -->
