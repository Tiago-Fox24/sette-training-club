                <div class="flex items-center gap-4">
                  <div class="w-24 h-24 shrink-0 rounded-xl overflow-hidden shadow-lg">
                    ${generateQrSvg('SETTE-' + appState.settings.dailyPin)}
                  </div>
                  <div class="flex-1">
                    <span class="text-[11px] uppercase tracking-widest text-zinc-400">PIN de Hoje</span>
                    <div class="font-display font-bold text-3xl tracking-[0.22em] text-emerald-400 mt-0.5">${appState.settings.dailyPin}</div>
                    <button onclick="copyText('${appState.settings.dailyPin}', 'PIN copiado!')" class="mt-2 inline-flex items-center gap-1.5 text-xs font-medium text-zinc-300 hover:text-white bg-zinc-800/80 px-2.5 py-1 rounded-lg transition">
                      <i data-lucide="copy" class="w-3 h-3"></i>
                      <span>Copiar PIN</span>
                    </button>
                  </div>
                </div>
              </div>

              <!-- Alertas Ativos (Combos & Evasão) -->
              <div class="rounded-2xl bg-sette-card border border-zinc-800/90 p-5">
                <h3 class="font-display font-bold text-base text-white mb-3 flex items-center gap-2">
                  <i data-lucide="radar" class="w-4 h-4 text-amber-400"></i>
                  Radar de Atenção
                </h3>
                <div class="space-y-2.5">
                  ${comboAlerts.map(a => `
                    <div class="p-3 rounded-xl bg-amber-500/10 border border-amber-500/30">
                      <div class="flex items-center justify-between gap-2">
                        <span class="text-xs font-bold text-amber-400">Combo Divergente</span>
