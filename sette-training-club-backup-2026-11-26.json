        : [];
      const peerIds = new Set(comboPeers.map(p => p.id));

      container.innerHTML = `
        <div class="space-y-6">
          <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
            <div>
              <h2 class="text-2xl font-display font-bold text-white">Agendamento Inteligente</h2>
