                        <span class="text-xs font-medium ${slot.isFull ? 'text-amber-400' : 'text-zinc-400'}">
                          ${slot.isExclusive ? 'Exclusivo 1/1' : `${slot.occupied}/${slot.capacity} vagas`}
                        </span>
                      </div>
                      <div class="space-y-2">
                        ${list.map(ses => {
                          const st = getStudentById(ses.studentId);
                          if (!st) return '';
                          return `
                            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 bg-zinc-900/90 border border-zinc-800/70 rounded-xl px-3 py-2">
