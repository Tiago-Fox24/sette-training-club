    window.viewStudentBioInPortal = function (studentId) {
      uiState.activeStudentId = studentId;
      uiState.mode = 'student';
      uiState.studentTab = 'bio';
      uiState.studentBioIndex = 0;
      renderApp();
    };

    window.saveBioEvaluation = function (event) {
      event.preventDefault();
      const fd = new FormData(event.target);
      const record = {
        id: 'bio-' + Date.now(),
        studentId: uiState.bioSelectedStudentId,
        date: fd.get('date'),
        weight: Number(fd.get('weight')),
        bodyFat: Number(fd.get('bodyFat')),
        muscleMass: Number(fd.get('muscleMass')),
        visceralFat: Number(fd.get('visceralFat')),
        bodyWater: Number(fd.get('bodyWater')),
        bmr: Number(fd.get('bmr')),
        metabolicAge: Number(fd.get('metabolicAge')),
        segments: {
          leftArm: { muscle: Number(fd.get('leftArm_muscle')), fat: Number(fd.get('leftArm_fat')) },
          rightArm: { muscle: Number(fd.get('rightArm_muscle')), fat: Number(fd.get('rightArm_fat')) },
          trunk: { muscle: Number(fd.get('trunk_muscle')), fat: Number(fd.get('trunk_fat')) },
          leftLeg: { muscle: Number(fd.get('leftLeg_muscle')), fat: Number(fd.get('leftLeg_fat')) },
          rightLeg: { muscle: Number(fd.get('rightLeg_muscle')), fat: Number(fd.get('rightLeg_fat')) }
        },
        feedback: fd.get('feedback').trim()
      };
      appState.bioimpedance.push(record);
      saveState();
      renderApp();
      showToast('Avaliação de bioimpedância registrada com sucesso!', 'success');
    };

    window.deleteBioEvaluation = function (bioId) {
      appState.bioimpedance = appState.bioimpedance.filter(b => b.id !== bioId);
      saveState();
      renderApp();
      showToast('Avaliação removida.', 'info');
    };

