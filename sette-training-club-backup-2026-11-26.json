    /**
     * Calcula a mensalidade exata seguindo as regras oficiais do portfólio Sette.
     */
    function calculateMonthlyPrice(modality, frequency, cycle, groupSize = 2, settings = appState?.settings) {
      const freq = Number(frequency);
      const grp = Number(groupSize) || 2;
      const trimDisc = settings?.performanceDiscounts?.trimestral ?? 5;
      const semDisc = settings?.performanceDiscounts?.semestral ?? 10;

      if (modality === 'SETTE_FIGHT') {
        const row = MODALITIES.SETTE_FIGHT.prices[freq] || MODALITIES.SETTE_FIGHT.prices[3];
        return row[cycle] ?? row.mensal;
      }

      if (modality === 'PERSONAL_INDIVIDUAL') {
        const row = MODALITIES.PERSONAL_INDIVIDUAL.prices[freq] || MODALITIES.PERSONAL_INDIVIDUAL.prices[3];
        return row[cycle] ?? row.mensal;
      }

      if (modality === 'PERFORMANCE_SETTE') {
        const grpRow = MODALITIES.PERFORMANCE_SETTE.basePrices[grp] || MODALITIES.PERFORMANCE_SETTE.basePrices[2];
        const base = grpRow[freq] ?? grpRow[3];
        if (cycle === 'trimestral') return Math.round(base * (1 - trimDisc / 100));
        if (cycle === 'semestral') return Math.round(base * (1 - semDisc / 100));
        return base;
      }

      return 0;
    }

