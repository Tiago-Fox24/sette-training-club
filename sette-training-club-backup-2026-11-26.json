                  ${churnRisks.map(item => `
                    <div class="p-3 rounded-xl bg-rose-500/10 border border-rose-500/30">
                      <div class="flex items-center justify-between gap-2">
                        <span class="text-xs font-bold text-rose-400">Risco de Evasão (${item.metrics.rate}%)</span>
                        <button onclick="setPersonalTab('reports')" class="text-[11px] text-rose-300 underline">Relatório</button>
