              let statusBadge = `<span class="px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-emerald-500/15 text-emerald-400 border border-emerald-500/30">${slot.occupied}/${mod.maxCapacity} vagas</span>`;
              if (mySessionHere) {
                statusBadge = `<span class="px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-emerald-500 text-zinc-950">Você está inscrito</span>`;
              } else if (slot.isExclusive) {
                statusBadge = `<span class="px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-zinc-800 text-zinc-400 border border-zinc-700">Personal Exclusivo (1/1)</span>`;
              } else if (isOtherModality) {
                statusBadge = `<span class="px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-zinc-800 text-zinc-400 border border-zinc-700">Turma ${MODALITIES[slot.activeModality].label}</span>`;
              } else if (slot.isFull) {
                statusBadge = `<span class="px-2.5 py-0.5 rounded-full text-[11px] font-semibold bg-rose-500/15 text-rose-400 border border-rose-500/30">Lotado (${slot.occupied}/${slot.capacity})</span>`;
              }

              return `
                <div class="rounded-2xl bg-sette-card border ${
                  mySessionHere
