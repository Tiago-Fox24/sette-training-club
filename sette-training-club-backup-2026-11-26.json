    window.submitStudentPinCheckin = function (event, sessionId) {
      event.preventDefault();
      const input = document.getElementById('studentPinInput').value.trim();
      if (input !== appState.settings.dailyPin) {
        return showToast('PIN inválido! Confira o código exibido na recepção da Sette.', 'error');
      }
      const ses = appState.sessions.find(s => s.id === sessionId);
      if (ses) {
        ses.status = 'presente';
        ses.checkinMethod = 'pin';
        saveState();
        renderApp();
        showToast('Check-in confirmado! Bom treino na Sette Training Club!', 'success');
      }
    };

    window.studentCancelSession = function (sessionId) {
      openConfirmModal(
        'Cancelar este horário?',
        'Seu crédito semanal será devolvido automaticamente e a vaga ficará livre para outros alunos.',
        'Confirmar Cancelamento',
        () => {
          appState.sessions = appState.sessions.filter(s => s.id !== sessionId);
          saveState();
          renderApp();
          showToast('Horário cancelado e crédito devolvido!', 'info');
        },
        false
      );
    };

