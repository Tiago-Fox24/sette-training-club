          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
            ${TIME_SLOTS.map(time => {
              const slot = analyzeSlot(uiState.selectedDay, time);
              const mySessionHere = slot.activeSessions.find(s => s.studentId === student.id);
              const peersHere = slot.activeSessions
                .filter(s => peerIds.has(s.studentId))
                .map(s => getStudentById(s.studentId)?.name.split(' ')[0])
