                <div>
                  <h3 class="font-display font-bold text-base text-white">Ocupação da Semana por Horário</h3>
                  <p class="text-xs text-zinc-400">Total de alunos agendados em cada faixa horária</p>
                </div>
              </div>
              <div class="h-60">
                <canvas id="dashboardOccupancyChart"></canvas>
              </div>
            </div>

            <div class="rounded-2xl bg-sette-card border border-zinc-800/90 p-5">
              <div class="flex items-center justify-between mb-4">
                <div>
                  <h3 class="font-display font-bold text-base text-white">Receita Mensal por Modalidade</h3>
                  <p class="text-xs text-zinc-400">Distribuição do portfólio Sette Training Club</p>
                </div>
              </div>
              <div class="h-60 flex items-center justify-center">
                <canvas id="dashboardRevenueChart"></canvas>
              </div>
            </div>
          </div>
        </div>
      `;

      // Inicializar gráficos do Dashboard
      initDashboardCharts();
    }

    function initDashboardCharts() {
      const occCanvas = document.getElementById('dashboardOccupancyChart');
      const revCanvas = document.getElementById('dashboardRevenueChart');
      if (!occCanvas || !revCanvas) return;

      const slotCounts = TIME_SLOTS.map(time =>
        appState.sessions.filter(s => s.time === time && s.status !== 'falta_justificada').length
      );

      activeCharts.occupancy = new Chart(occCanvas, {
        type: 'bar',
        data: {
          labels: TIME_SLOTS,
          datasets: [{
            label: 'Agendamentos na Semana',
            data: slotCounts,
            backgroundColor: slotCounts.map(v => v >= 5 ? '#10b981' : v > 0 ? 'rgba(16, 185, 129, 0.45)' : '#27272a'),
            borderRadius: 6,
            maxBarThickness: 24
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: {
            legend: { display: false },
            tooltip: { backgroundColor: '#18181b', borderColor: '#3f3f46', borderWidth: 1 }
          },
          scales: {
            x: { ticks: { color: '#a1a1aa', font: { size: 10 } }, grid: { display: false } },
            y: { beginAtZero: true, ticks: { stepSize: 2, color: '#a1a1aa', font: { size: 10 } }, grid: { color: '#27272a' } }
          }
        }
      });

      const revByMod = {
        SETTE_FIGHT: 0,
        PERFORMANCE_SETTE: 0,
        PERSONAL_INDIVIDUAL: 0
      };
      appState.students.filter(s => s.status === 'ativo').forEach(s => {
        revByMod[s.modality] += calculateMonthlyPrice(s.modality, s.frequency, s.cycle, s.groupSize);
      });

      activeCharts.revenue = new Chart(revCanvas, {
        type: 'doughnut',
        data: {
          labels: ['Sette Fight', 'Performance Sette', 'Personal Individual'],
          datasets: [{
            data: [revByMod.SETTE_FIGHT, revByMod.PERFORMANCE_SETTE, revByMod.PERSONAL_INDIVIDUAL],
            backgroundColor: ['#f59e0b', '#10b981', '#e4e4e7'],
            borderColor: '#111114',
            borderWidth: 3
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          cutout: '66%',
          plugins: {
            legend: {
              position: 'bottom',
              labels: { color: '#d4d4d8', padding: 16, font: { size: 12 } }
            },
            tooltip: {
              backgroundColor: '#18181b',
              callbacks: {
                label: (ctx) => ` ${ctx.label}: ${formatBRL(ctx.raw)}`
              }
            }
          }
        }
      });
    }

    window.selectDashboardDay = function (dayId) {
      uiState.selectedDay = dayId;
      renderApp();
    };

    window.goToCombosTab = function () {
      uiState.personalTab = 'students';
      uiState.studentsSubTab = 'combos';
      renderApp();
    };

    window.regenerateDailyPin = function () {
      const newPin = String(Math.floor(1000 + Math.random() * 9000));
      appState.settings.dailyPin = newPin;
      appState.settings.pinUpdatedAt = new Date().toLocaleDateString('pt-BR');
      saveState();
      renderApp();
      showToast(`Novo PIN diário gerado: ${newPin}`, 'success');
    };

    window.copyText = function (text, successMsg = 'Copiado!') {
      const ta = document.createElement('textarea');
      ta.value = text;
      ta.style.position = 'fixed';
      ta.style.opacity = '0';
      document.body.appendChild(ta);
      ta.select();
      try {
        document.execCommand('copy');
        showToast(successMsg, 'info');
      } catch (e) {
        showToast('Não foi possível copiar automaticamente.', 'warning');
      }
      ta.remove();
    };

    /* ============================================================================
       8. MÓDULO PERSONAL: ALUNOS & COMBOS VINCULADOS
       ============================================================================ */
    function renderPersonalStudentsAndCombos(container) {
      const comboAlerts = getComboAlerts();
      const filteredStudents = appState.students.filter(s => {
        const matchSearch = s.name.toLowerCase().includes(uiState.studentSearch.toLowerCase()) ||
          (s.phone || '').includes(uiState.studentSearch);
        const matchMod = uiState.studentFilterModality === 'ALL' || s.modality === uiState.studentFilterModality;
        return matchSearch && matchMod;
      });

      container.innerHTML = `
        <div class="space-y-6">
          <!-- Cabeçalho -->
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div>
              <h2 class="text-2xl font-display font-bold text-white">Alunos & Gestão de Combos</h2>
              <p class="text-sm text-zinc-400">Cadastro com precificação automática do portfólio e grupos vinculados.</p>
            </div>
            <div class="flex flex-wrap items-center gap-2">
              <button onclick="openDiscountSettingsModal()" class="flex items-center gap-2 px-3.5 py-2 rounded-xl bg-zinc-900 border border-zinc-800 hover:border-zinc-700 text-xs sm:text-sm text-zinc-300 transition">
                <i data-lucide="percent" class="w-4 h-4 text-amber-400"></i>
                <span>Descontos Performance (${appState.settings.performanceDiscounts.trimestral}% / ${appState.settings.performanceDiscounts.semestral}%)</span>
              </button>
              <button onclick="openComboModal()" class="flex items-center gap-2 px-3.5 py-2 rounded-xl bg-amber-500 hover:bg-amber-400 text-zinc-950 font-semibold text-xs sm:text-sm transition">
                <i data-lucide="layers" class="w-4 h-4"></i>
                <span>Novo Combo</span>
              </button>
              <button onclick="openStudentModal()" class="flex items-center gap-2 px-3.5 py-2 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-zinc-950 font-semibold text-xs sm:text-sm transition">
                <i data-lucide="user-plus" class="w-4 h-4"></i>
                <span>Novo Aluno</span>
              </button>
            </div>
          </div>

          <!-- Sub-abas -->
          <div class="flex items-center gap-2 border-b border-zinc-800 pb-3">
            <button onclick="setStudentsSubTab('list')" class="px-4 py-2 rounded-xl text-sm font-semibold transition ${
              uiState.studentsSubTab === 'list' ? 'bg-zinc-800 text-white' : 'text-zinc-400 hover:text-white'
            }">
              Lista de Alunos (${appState.students.length})
            </button>
            <button onclick="setStudentsSubTab('combos')" class="flex items-center gap-2 px-4 py-2 rounded-xl text-sm font-semibold transition ${
              uiState.studentsSubTab === 'combos' ? 'bg-zinc-800 text-white' : 'text-zinc-400 hover:text-white'
            }">
              <span>Combos & Pacotes (${appState.combos.length})</span>
              ${comboAlerts.length > 0 ? `<span class="px-1.5 py-0.5 text-[10px] font-bold rounded-full bg-amber-500 text-zinc-950">${comboAlerts.length} alerta</span>` : ''}
            </button>
          </div>

          ${uiState.studentsSubTab === 'list' ? `
            <!-- Filtros -->
            <div class="flex flex-col sm:flex-row gap-3">
              <div class="relative flex-1">
                <i data-lucide="search" class="w-4 h-4 text-zinc-500 absolute left-3.5 top-1/2 -translate-y-1/2"></i>
                <input type="text" value="${uiState.studentSearch}" oninput="updateStudentSearch(this.value)" placeholder="Buscar por nome ou telefone..." class="w-full bg-sette-card border border-zinc-800 rounded-xl pl-10 pr-4 py-2.5 text-sm text-white placeholder-zinc-500 focus:outline-none focus:border-emerald-500" />
              </div>
              <select onchange="updateStudentModalityFilter(this.value)" class="bg-sette-card border border-zinc-800 rounded-xl px-4 py-2.5 text-sm text-zinc-200 focus:outline-none focus:border-emerald-500">
                <option value="ALL" ${uiState.studentFilterModality === 'ALL' ? 'selected' : ''}>Todas as Modalidades</option>
                <option value="PERFORMANCE_SETTE" ${uiState.studentFilterModality === 'PERFORMANCE_SETTE' ? 'selected' : ''}>Performance Sette</option>
                <option value="SETTE_FIGHT" ${uiState.studentFilterModality === 'SETTE_FIGHT' ? 'selected' : ''}>Sette Fight</option>
                <option value="PERSONAL_INDIVIDUAL" ${uiState.studentFilterModality === 'PERSONAL_INDIVIDUAL' ? 'selected' : ''}>Personal Individual</option>
              </select>
            </div>

            <!-- Grid de Cards de Alunos -->
            <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
              ${filteredStudents.map(st => {
                const mod = MODALITIES[st.modality];
                const price = calculateMonthlyPrice(st.modality, st.frequency, st.cycle, st.groupSize);
                const combo = getComboById(st.comboId);
                const credits = getStudentWeeklyCredits(st.id);
                const att = getStudentAttendanceMetrics(st);
                return `
                  <div class="rounded-2xl bg-sette-card border border-zinc-800/90 p-5 flex flex-col justify-between hover:border-zinc-700 transition">
                    <div>
                      <div class="flex items-start justify-between gap-3">
                        <div class="flex items-center gap-3">
                          <div class="w-11 h-11 rounded-xl bg-zinc-800 border border-zinc-700 flex items-center justify-center font-display font-bold text-emerald-400">
                            ${getInitials(st.name)}
                          </div>
                          <div>
                            <h3 class="font-semibold text-white leading-tight">${st.name}</h3>
                            <p class="text-xs text-zinc-400 mt-0.5">${st.phone || 'Sem telefone'}</p>
                          </div>
                        </div>
                        <span class="px-2.5 py-1 rounded-full text-[11px] font-semibold border ${mod.badgeClass}">${mod.label}</span>
                      </div>

                      <div class="grid grid-cols-3 gap-2 mt-4 p-3 rounded-xl bg-zinc-950/70 border border-zinc-800/70 text-center">
                        <div>
                          <span class="block text-[10px] uppercase text-zinc-500">Plano</span>
                          <span class="text-xs font-semibold text-zinc-200">${st.frequency}x • ${CYCLES[st.cycle].label}</span>
                        </div>
                        <div>
                          <span class="block text-[10px] uppercase text-zinc-500">Mensalidade</span>
                          <span class="text-xs font-bold text-emerald-400">${formatBRL(price)}</span>
                        </div>
                        <div>
                          <span class="block text-[10px] uppercase text-zinc-500">Créditos Sem.</span>
                          <span class="text-xs font-semibold text-white">${credits.used}/${credits.limit}</span>
                        </div>
                      </div>

                      ${combo ? `
                        <div class="mt-3 flex items-center gap-2 px-3 py-2 rounded-xl bg-amber-500/10 border border-amber-500/20">
                          <i data-lucide="layers" class="w-3.5 h-3.5 text-amber-400 shrink-0"></i>
                          <span class="text-xs text-amber-200 truncate"><strong>${combo.name}</strong></span>
                        </div>
                      ` : ''}

                      <div class="mt-3 space-y-1.5 text-xs">
                        <p class="text-zinc-300"><span class="text-zinc-500">Objetivo:</span> ${st.goal || 'Não informado'}</p>
                        <p class="text-zinc-400 line-clamp-2"><span class="text-zinc-500">Anamnese:</span> ${st.anamnesis || 'Sem restrições registradas.'}</p>
                      </div>
                    </div>

                    <div class="flex items-center justify-between gap-2 mt-4 pt-3 border-t border-zinc-800/80">
                      <span class="text-xs font-semibold ${att.level === 'green' ? 'text-emerald-400' : att.level === 'amber' ? 'text-amber-400' : 'text-rose-400'}">
                        Constância: ${att.rate}%
                      </span>
                      <div class="flex items-center gap-1.5">
                        <button onclick="openBioForStudent('${st.id}')" title="Lançar Bioimpedância" class="p-2 rounded-lg bg-zinc-900 hover:bg-zinc-800 border border-zinc-800 text-emerald-400 transition">
                          <i data-lucide="activity" class="w-3.5 h-3.5"></i>
                        </button>
                        <button onclick="simulateStudentPortal('${st.id}')" title="Ver Portal deste Aluno" class="p-2 rounded-lg bg-zinc-900 hover:bg-zinc-800 border border-zinc-800 text-zinc-300 hover:text-white transition">
                          <i data-lucide="external-link" class="w-3.5 h-3.5"></i>
                        </button>
                        <button onclick="openStudentModal('${st.id}')" title="Editar Aluno" class="p-2 rounded-lg bg-zinc-900 hover:bg-zinc-800 border border-zinc-800 text-zinc-300 hover:text-white transition">
                          <i data-lucide="pencil" class="w-3.5 h-3.5"></i>
                        </button>
                        <button onclick="requestDeleteStudent('${st.id}')" title="Excluir Aluno" class="p-2 rounded-lg bg-zinc-900 hover:bg-rose-500/20 border border-zinc-800 text-zinc-400 hover:text-rose-400 transition">
                          <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                        </button>
                      </div>
                    </div>
                  </div>
                `;
              }).join('')}
            </div>
          ` : `
            <!-- SEÇÃO DEDICADA DE COMBOS -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">
              ${appState.combos.map(combo => {
                const members = getComboMembers(combo.id);
                const isMismatch = members.length !== combo.targetSize;
                const mod = MODALITIES[combo.modality];
                const comboTotalRevenue = members.reduce(
                  (sum, m) => sum + calculateMonthlyPrice(m.modality, m.frequency, m.cycle, m.groupSize),
                  0
                );
                return `
                  <div class="rounded-2xl bg-sette-card border ${isMismatch ? 'border-amber-500/50' : 'border-zinc-800/90'} p-5 flex flex-col justify-between">
                    <div>
                      <div class="flex items-start justify-between gap-3">
                        <div>
                          <div class="flex items-center gap-2 flex-wrap">
                            <h3 class="font-display font-bold text-lg text-white">${combo.name}</h3>
                            <span class="px-2.5 py-0.5 rounded-full text-[11px] font-semibold border ${mod.badgeClass}">${mod.label}</span>
                          </div>
                          <p class="text-xs text-zinc-400 mt-1">Horário preferencial: <strong class="text-zinc-200">${combo.preferredTime || 'Livre'}</strong> • ${combo.notes || ''}</p>
                        </div>
                        <div class="flex items-center gap-1">
                          <button onclick="openComboModal('${combo.id}')" class="p-2 rounded-lg bg-zinc-900 hover:bg-zinc-800 border border-zinc-800 text-zinc-300 transition">
                            <i data-lucide="pencil" class="w-4 h-4"></i>
                          </button>
                          <button onclick="requestDeleteCombo('${combo.id}')" class="p-2 rounded-lg bg-zinc-900 hover:bg-rose-500/20 border border-zinc-800 text-zinc-400 hover:text-rose-400 transition">
                            <i data-lucide="trash-2" class="w-4 h-4"></i>
                          </button>
                        </div>
                      </div>

                      <!-- Alerta automático de divergência -->
                      ${isMismatch ? `
                        <div class="mt-4 p-3 rounded-xl bg-amber-500/15 border border-amber-500/40 flex items-start gap-2.5">
                          <i data-lucide="alert-triangle" class="w-4 h-4 text-amber-400 shrink-0 mt-0.5"></i>
                          <div class="text-xs text-amber-200 leading-relaxed">
                            <strong>Divergência de Pacote:</strong> Este combo foi contratado para <strong>${combo.targetSize} aluno(s)</strong>, mas possui <strong>${members.length} membro(s) ativo(s)</strong>.
                            ${members.length < combo.targetSize
                              ? 'Recomenda-se abrir vaga para recompor o grupo ou ajustar a faixa de preço na renovação.'
                              : 'O grupo excedeu o tamanho contratado; verifique os vínculos.'}
                          </div>
                        </div>
                      ` : `
                        <div class="mt-4 p-2.5 rounded-xl bg-emerald-500/10 border border-emerald-500/25 flex items-center gap-2 text-xs text-emerald-300">
                          <i data-lucide="check-circle-2" class="w-4 h-4 shrink-0"></i>
                          <span>Composição completa: ${members.length}/${combo.targetSize} membros ativos conforme contratado.</span>
                        </div>
                      `}

                      <!-- Lista de integrantes vinculados -->
                      <div class="mt-4">
                        <div class="flex items-center justify-between text-xs text-zinc-400 mb-2">
                          <span>Integrantes Vinculados (${members.length}/${combo.targetSize})</span>
                          <span class="font-semibold text-emerald-400">Faturamento do Combo: ${formatBRL(comboTotalRevenue)}/mês</span>
                        </div>
                        <div class="space-y-2">
                          ${members.length === 0 ? `
                            <p class="text-xs text-zinc-500 italic py-2">Nenhum aluno vinculado a este combo ainda.</p>
                          ` : members.map(m => `
                            <div class="flex items-center justify-between gap-2 px-3 py-2 rounded-xl bg-zinc-950/80 border border-zinc-800/80">
                              <div class="flex items-center gap-2.5">
                                <div class="w-7 h-7 rounded-lg bg-zinc-800 text-[11px] font-bold text-emerald-400 flex items-center justify-center">${getInitials(m.name)}</div>
                                <div>
                                  <p class="text-xs font-semibold text-white">${m.name}</p>
                                  <p class="text-[11px] text-zinc-400">${m.frequency}x/sem • ${CYCLES[m.cycle].label} • ${formatBRL(calculateMonthlyPrice(m.modality, m.frequency, m.cycle, m.groupSize))}</p>
                                </div>
                              </div>
                              <button onclick="unlinkStudentFromCombo('${m.id}')" title="Desvincular do combo" class="text-xs text-zinc-500 hover:text-rose-400 px-2 py-1 rounded-lg hover:bg-zinc-900 transition">Desvincular</button>
                            </div>
                          `).join('')}
                        </div>
                      </div>
                    </div>

                    <!-- Vincular novo aluno ao combo -->
                    <div class="mt-4 pt-3 border-t border-zinc-800 flex items-center gap-2">
                      <select id="addMemberSelect-${combo.id}" class="flex-1 bg-zinc-950 border border-zinc-800 rounded-xl px-3 py-2 text-xs text-zinc-200 focus:outline-none focus:border-emerald-500">
                        <option value="">+ Vincular aluno ao combo...</option>
                        ${appState.students
                          .filter(s => s.comboId !== combo.id && s.modality === combo.modality)
                          .map(s => `<option value="${s.id}">${s.name} (${s.frequency}x/sem)</option>`)
                          .join('')}
                      </select>
                      <button onclick="linkStudentToCombo('${combo.id}')" class="px-3.5 py-2 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-zinc-950 font-semibold text-xs transition shrink-0">
                        Vincular
                      </button>
                    </div>
                  </div>
                `;
              }).join('')}
            </div>
          `}
        </div>
      `;
    }

    window.setStudentsSubTab = function (sub) {
      uiState.studentsSubTab = sub;
      renderApp();
    };

    window.updateStudentSearch = function (val) {
      uiState.studentSearch = val;
      renderApp();
    };

    window.updateStudentModalityFilter = function (val) {
      uiState.studentFilterModality = val;
      renderApp();
    };

    window.simulateStudentPortal = function (studentId) {
      uiState.activeStudentId = studentId;
      uiState.mode = 'student';
      uiState.studentTab = 'summary';
      renderApp();
    };

    window.openBioForStudent = function (studentId) {
      uiState.bioSelectedStudentId = studentId;
      uiState.personalTab = 'bio';
      renderApp();
    };

    window.linkStudentToCombo = function (comboId) {
      const sel = document.getElementById(`addMemberSelect-${comboId}`);
      const studentId = sel?.value;
      if (!studentId) return showToast('Selecione um aluno para vincular.', 'warning');
      const student = getStudentById(studentId);
      const combo = getComboById(comboId);
      if (student && combo) {
        student.comboId = comboId;
        if (combo.modality === 'PERFORMANCE_SETTE') {
          student.groupSize = combo.targetSize;
        }
        saveState();
        renderApp();
        showToast(`${student.name} vinculado(a) ao ${combo.name}!`, 'success');
      }
    };

    window.unlinkStudentFromCombo = function (studentId) {
      const student = getStudentById(studentId);
      if (!student) return;
      student.comboId = null;
      saveState();
      renderApp();
      showToast(`${student.name} desvinculado(a) do combo.`, 'info');
    };

    /* --- Modal de Cadastro / Edição de Aluno --- */
    window.openStudentModal = function (studentId = null) {
      const st = studentId ? getStudentById(studentId) : null;
      const modality = st ? st.modality : 'PERFORMANCE_SETTE';
      const frequency = st ? st.frequency : 3;
      const cycle = st ? st.cycle : 'trimestral';
      const groupSize = st ? st.groupSize : 2;
      const comboId = st ? (st.comboId || '') : '';

      openModal(`
        <div class="p-5 border-b border-zinc-800 flex items-center justify-between">
          <div>
            <h3 class="font-display font-bold text-lg text-white">${st ? 'Editar Aluno' : 'Cadastrar Novo Aluno'}</h3>
            <p class="text-xs text-zinc-400">O valor mensal é calculado automaticamente pelo portfólio Sette.</p>
          </div>
          <button onclick="closeModal()" class="p-2 rounded-xl hover:bg-zinc-800 text-zinc-400 hover:text-white"><i data-lucide="x" class="w-5 h-5"></i></button>
        </div>
        <form id="studentForm" onsubmit="saveStudentForm(event, '${st ? st.id : ''}')" class="p-5 overflow-y-auto space-y-4">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-medium text-zinc-400 mb-1">Nome Completo *</label>
              <input name="name" required value="${st ? st.name : ''}" class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-3.5 py-2.5 text-sm text-white focus:outline-none focus:border-emerald-500" placeholder="Ex: João Silva" />
            </div>
            <div>
              <label class="block text-xs font-medium text-zinc-400 mb-1">Telefone / WhatsApp</label>
              <input name="phone" value="${st ? st.phone : ''}" class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-3.5 py-2.5 text-sm text-white focus:outline-none focus:border-emerald-500" placeholder="(11) 99999-9999" />
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div>
              <label class="block text-xs font-medium text-zinc-400 mb-1">Modalidade *</label>
              <select id="sfModality" name="modality" onchange="refreshStudentFormOptions()" class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-3 py-2.5 text-sm text-white focus:outline-none focus:border-emerald-500">
                <option value="PERFORMANCE_SETTE" ${modality === 'PERFORMANCE_SETTE' ? 'selected' : ''}>Performance Sette</option>
                <option value="SETTE_FIGHT" ${modality === 'SETTE_FIGHT' ? 'selected' : ''}>Sette Fight (Muay Thai)</option>
                <option value="PERSONAL_INDIVIDUAL" ${modality === 'PERSONAL_INDIVIDUAL' ? 'selected' : ''}>Personal Individual</option>
              </select>
            </div>
            <div>
              <label class="block text-xs font-medium text-zinc-400 mb-1">Frequência Semanal *</label>
              <select id="sfFrequency" name="frequency" onchange="updateStudentFormPricePreview()" class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-3 py-2.5 text-sm text-white focus:outline-none focus:border-emerald-500">
              </select>
            </div>
            <div>
              <label class="block text-xs font-medium text-zinc-400 mb-1">Ciclo do Plano *</label>
              <select id="sfCycle" name="cycle" onchange="updateStudentFormPricePreview()" class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-3 py-2.5 text-sm text-white focus:outline-none focus:border-emerald-500">
                <option value="mensal" ${cycle === 'mensal' ? 'selected' : ''}>Mensal</option>
                <option value="trimestral" ${cycle === 'trimestral' ? 'selected' : ''}>Trimestral</option>
                <option value="semestral" ${cycle === 'semestral' ? 'selected' : ''}>Semestral</option>
              </select>
            </div>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div id="sfGroupSizeWrap">
              <label class="block text-xs font-medium text-zinc-400 mb-1">Faixa do Grupo (Performance)</label>
              <select id="sfGroupSize" name="groupSize" onchange="updateStudentFormPricePreview()" class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-3 py-2.5 text-sm text-white focus:outline-none focus:border-emerald-500">
                <option value="2" ${groupSize == 2 ? 'selected' : ''}>Grupo de 2 pessoas</option>
                <option value="3" ${groupSize == 3 ? 'selected' : ''}>Grupo de 3 pessoas</option>
                <option value="4" ${groupSize == 4 ? 'selected' : ''}>Grupo de 4 pessoas</option>
              </select>
            </div>
            <div class="sm:col-span-2">
              <label class="block text-xs font-medium text-zinc-400 mb-1">Vincular a um Combo (Opcional)</label>
              <select id="sfComboId" name="comboId" class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-3 py-2.5 text-sm text-white focus:outline-none focus:border-emerald-500">
                <option value="">Sem combo vinculado</option>
                ${appState.combos.map(c => `<option value="${c.id}" ${comboId === c.id ? 'selected' : ''}>${c.name} (${MODALITIES[c.modality].label})</option>`).join('')}
              </select>
            </div>
          </div>

          <!-- Preview dinâmico da mensalidade -->
          <div class="p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/30 flex items-center justify-between">
            <div>
              <span class="text-xs uppercase tracking-wider text-emerald-300 font-semibold">Valor Mensal Calculado</span>
              <p id="sfPriceRuleHint" class="text-[11px] text-zinc-400 mt-0.5"></p>
            </div>
            <span id="sfPricePreview" class="font-display font-bold text-2xl text-emerald-400">R$ 0,00</span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-medium text-zinc-400 mb-1">Sexo Biológico (Referência Bio)</label>
              <select name="gender" class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-3 py-2.5 text-sm text-white focus:outline-none focus:border-emerald-500">
                <option value="F" ${st?.gender === 'F' ? 'selected' : ''}>Feminino</option>
                <option value="M" ${st?.gender === 'M' ? 'selected' : ''}>Masculino</option>
              </select>
            </div>
            <div>
              <label class="block text-xs font-medium text-zinc-400 mb-1">Objetivo Principal</label>
              <input name="goal" value="${st ? st.goal : ''}" class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-3.5 py-2.5 text-sm text-white focus:outline-none focus:border-emerald-500" placeholder="Ex: Hipertrofia, emagrecimento, Muay Thai" />
            </div>
          </div>

          <div>
            <label class="block text-xs font-medium text-zinc-400 mb-1">Anamnese & Observações Clínicas</label>
            <textarea name="anamnesis" rows="3" class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-3.5 py-2.5 text-sm text-white focus:outline-none focus:border-emerald-500" placeholder="Lesões prévias, restrições articulares, medicamentos...">${st ? st.anamnesis : ''}</textarea>
          </div>

          <div class="flex items-center justify-end gap-2 pt-3 border-t border-zinc-800">
            <button type="button" onclick="closeModal()" class="px-4 py-2.5 rounded-xl bg-zinc-800 hover:bg-zinc-700 text-sm text-zinc-200 font-medium">Cancelar</button>
            <button type="submit" class="px-5 py-2.5 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-zinc-950 text-sm font-bold transition">Salvar Aluno</button>
          </div>
        </form>
      `);

      // Popular frequências iniciais
      refreshStudentFormOptions(frequency);
    };

    window.refreshStudentFormOptions = function (preferredFreq = null) {
      const modId = document.getElementById('sfModality').value;
      const freqSelect = document.getElementById('sfFrequency');
      const groupWrap = document.getElementById('sfGroupSizeWrap');
      const freqs = MODALITIES[modId].frequencies;
      const currentVal = preferredFreq || Number(freqSelect.value);

      freqSelect.innerHTML = freqs.map(f => `<option value="${f}" ${f === currentVal ? 'selected' : ''}>${f}x por semana</option>`).join('');
      if (modId === 'PERFORMANCE_SETTE') {
        groupWrap.classList.remove('opacity-40', 'pointer-events-none');
      } else {
        groupWrap.classList.add('opacity-40', 'pointer-events-none');
      }
      updateStudentFormPricePreview();
    };

    window.updateStudentFormPricePreview = function () {
      const modId = document.getElementById('sfModality').value;
      const freq = Number(document.getElementById('sfFrequency').value);
      const cycle = document.getElementById('sfCycle').value;
      const grp = Number(document.getElementById('sfGroupSize').value);
      const price = calculateMonthlyPrice(modId, freq, cycle, grp);
      document.getElementById('sfPricePreview').textContent = formatBRL(price);

      let hint = `${MODALITIES[modId].label} • ${freq}x/semana • Plano ${CYCLES[cycle].label}`;
      if (modId === 'PERFORMANCE_SETTE') {
        const d = cycle === 'trimestral'
          ? ` (-${appState.settings.performanceDiscounts.trimestral}%)`
          : cycle === 'semestral'
            ? ` (-${appState.settings.performanceDiscounts.semestral}%)`
            : '';
        hint = `Grupo de ${grp} pessoas • ${freq}x/sem • ${CYCLES[cycle].label}${d}`;
      }
      document.getElementById('sfPriceRuleHint').textContent = hint;
    };

    window.saveStudentForm = function (event, existingId) {
      event.preventDefault();
      const fd = new FormData(event.target);
      const modality = fd.get('modality');
      const payload = {
        name: fd.get('name').trim(),
        phone: fd.get('phone').trim(),
        gender: fd.get('gender'),
        modality,
        frequency: Number(fd.get('frequency')),
        cycle: fd.get('cycle'),
        groupSize: modality === 'PERFORMANCE_SETTE' ? Number(fd.get('groupSize')) : 1,
        comboId: fd.get('comboId') || null,
        goal: fd.get('goal').trim(),
        anamnesis: fd.get('anamnesis').trim(),
        status: 'ativo'
      };

      if (existingId) {
        const idx = appState.students.findIndex(s => s.id === existingId);
        if (idx !== -1) {
          appState.students[idx] = { ...appState.students[idx], ...payload };
          showToast(`Cadastro de ${payload.name} atualizado!`, 'success');
        }
      } else {
        const newStudent = {
          id: 'stu-' + Date.now(),
          ...payload,
          historyStats: { attended: 0, justified: 0, noShow: 0 }
        };
        appState.students.push(newStudent);
        showToast(`${payload.name} cadastrado(a) com sucesso!`, 'success');
      }

      saveState();
      closeModal();
      renderApp();
    };

    window.requestDeleteStudent = function (studentId) {
      const st = getStudentById(studentId);
      if (!st) return;
      openConfirmModal(
        `Remover ${st.name}?`,
        'O aluno será excluído do cadastro e seus agendamentos desta semana serão removidos da grade.',
        'Excluir Aluno',
        () => {
          appState.students = appState.students.filter(s => s.id !== studentId);
          appState.sessions = appState.sessions.filter(s => s.studentId !== studentId);
          appState.bioimpedance = appState.bioimpedance.filter(b => b.studentId !== studentId);
          if (uiState.activeStudentId === studentId && appState.students.length > 0) {
            uiState.activeStudentId = appState.students[0].id;
          }
          saveState();
          renderApp();
          showToast(`${st.name} removido(a) do sistema.`, 'info');
        }
      );
    };

    /* --- Modal de Combo --- */
    window.openComboModal = function (comboId = null) {
      const c = comboId ? getComboById(comboId) : null;
      openModal(`
        <div class="p-5 border-b border-zinc-800 flex items-center justify-between">
          <div>
            <h3 class="font-display font-bold text-lg text-white">${c ? 'Editar Combo / Pacote' : 'Criar Novo Combo'}</h3>
            <p class="text-xs text-zinc-400">Agrupe alunos que compartilham o mesmo pacote de treino.</p>
          </div>
          <button onclick="closeModal()" class="p-2 rounded-xl hover:bg-zinc-800 text-zinc-400 hover:text-white"><i data-lucide="x" class="w-5 h-5"></i></button>
        </div>
        <form onsubmit="saveComboForm(event, '${c ? c.id : ''}')" class="p-5 space-y-4">
          <div>
            <label class="block text-xs font-medium text-zinc-400 mb-1">Nome do Combo *</label>
            <input name="name" required value="${c ? c.name : ''}" placeholder="Ex: Combo Trio 07h — Performance" class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-3.5 py-2.5 text-sm text-white focus:outline-none focus:border-emerald-500" />
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
            <div>
              <label class="block text-xs font-medium text-zinc-400 mb-1">Modalidade</label>
              <select name="modality" class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-3 py-2.5 text-sm text-white focus:outline-none focus:border-emerald-500">
                <option value="PERFORMANCE_SETTE" ${c?.modality === 'PERFORMANCE_SETTE' ? 'selected' : ''}>Performance Sette</option>
                <option value="SETTE_FIGHT" ${c?.modality === 'SETTE_FIGHT' ? 'selected' : ''}>Sette Fight</option>
              </select>
            </div>
            <div>
              <label class="block text-xs font-medium text-zinc-400 mb-1">Tamanho Contratado</label>
              <select name="targetSize" class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-3 py-2.5 text-sm text-white focus:outline-none focus:border-emerald-500">
                <option value="2" ${c?.targetSize == 2 ? 'selected' : ''}>2 pessoas (Dupla)</option>
                <option value="3" ${c?.targetSize == 3 ? 'selected' : ''}>3 pessoas (Trio)</option>
                <option value="4" ${c?.targetSize == 4 ? 'selected' : ''}>4 pessoas (Quarteto)</option>
              </select>
            </div>
            <div>
              <label class="block text-xs font-medium text-zinc-400 mb-1">Horário Preferencial</label>
              <select name="preferredTime" class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-3 py-2.5 text-sm text-white focus:outline-none focus:border-emerald-500">
                ${TIME_SLOTS.map(t => `<option value="${t}" ${c?.preferredTime === t ? 'selected' : ''}>${t}</option>`).join('')}
              </select>
            </div>
          </div>
          <div>
            <label class="block text-xs font-medium text-zinc-400 mb-1">Observações do Grupo</label>
            <textarea name="notes" rows="2" class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-3.5 py-2.5 text-sm text-white focus:outline-none focus:border-emerald-500" placeholder="Detalhes do grupo...">${c ? c.notes : ''}</textarea>
          </div>
          <div class="flex items-center justify-end gap-2 pt-3 border-t border-zinc-800">
            <button type="button" onclick="closeModal()" class="px-4 py-2 rounded-xl bg-zinc-800 text-sm text-zinc-200">Cancelar</button>
            <button type="submit" class="px-5 py-2 rounded-xl bg-amber-500 hover:bg-amber-400 text-zinc-950 text-sm font-bold">Salvar Combo</button>
          </div>
        </form>
      `, 'max-w-lg');
    };

    window.saveComboForm = function (event, existingId) {
      event.preventDefault();
      const fd = new FormData(event.target);
      const payload = {
        name: fd.get('name').trim(),
        modality: fd.get('modality'),
        targetSize: Number(fd.get('targetSize')),
        preferredTime: fd.get('preferredTime'),
        notes: fd.get('notes').trim()
      };
      if (existingId) {
        const idx = appState.combos.findIndex(c => c.id === existingId);
        if (idx !== -1) appState.combos[idx] = { ...appState.combos[idx], ...payload };
        showToast('Combo atualizado!', 'success');
      } else {
        appState.combos.push({ id: 'cmb-' + Date.now(), ...payload });
        showToast('Novo combo criado!', 'success');
      }
      saveState();
      closeModal();
      uiState.studentsSubTab = 'combos';
      renderApp();
    };

    window.requestDeleteCombo = function (comboId) {
      const c = getComboById(comboId);
      if (!c) return;
      openConfirmModal(
        `Excluir ${c.name}?`,
        'Os alunos continuarão cadastrados, mas ficarão sem vínculo de combo.',
        'Excluir Combo',
        () => {
          appState.combos = appState.combos.filter(x => x.id !== comboId);
          appState.students.forEach(s => { if (s.comboId === comboId) s.comboId = null; });
          saveState();
          renderApp();
          showToast('Combo excluído.', 'info');
        }
      );
    };

    window.openDiscountSettingsModal = function () {
      const d = appState.settings.performanceDiscounts;
      openModal(`
        <div class="p-5 border-b border-zinc-800 flex items-center justify-between">
          <h3 class="font-display font-bold text-lg text-white">Descontos — Performance Sette</h3>
          <button onclick="closeModal()" class="p-2 rounded-xl hover:bg-zinc-800 text-zinc-400"><i data-lucide="x" class="w-5 h-5"></i></button>
        </div>
        <form onsubmit="saveDiscountSettings(event)" class="p-5 space-y-4">
          <p class="text-xs text-zinc-400 leading-relaxed">Configure os descontos percentuais aplicados automaticamente sobre a tabela mensal do Performance Sette para planos Trimestrais e Semestrais.</p>
          <div class="grid grid-cols-2 gap-4">
            <div>
              <label class="block text-xs font-medium text-zinc-400 mb-1">Desconto Trimestral (%)</label>
              <input type="number" name="trimestral" min="0" max="40" value="${d.trimestral}" required class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-3.5 py-2.5 text-sm text-white focus:outline-none focus:border-emerald-500" />
            </div>
            <div>
              <label class="block text-xs font-medium text-zinc-400 mb-1">Desconto Semestral (%)</label>
              <input type="number" name="semestral" min="0" max="50" value="${d.semestral}" required class="w-full bg-zinc-950 border border-zinc-800 rounded-xl px-3.5 py-2.5 text-sm text-white focus:outline-none focus:border-emerald-500" />
            </div>
          </div>
          <div class="flex justify-end gap-2 pt-3 border-t border-zinc-800">
            <button type="button" onclick="closeModal()" class="px-4 py-2 rounded-xl bg-zinc-800 text-sm text-zinc-200">Cancelar</button>
            <button type="submit" class="px-4 py-2 rounded-xl bg-emerald-500 text-zinc-950 font-bold text-sm">Aplicar Descontos</button>
          </div>
        </form>
      `, 'max-w-md');
    };

    window.saveDiscountSettings = function (event) {
      event.preventDefault();
      const fd = new FormData(event.target);
      appState.settings.performanceDiscounts = {
        trimestral: Number(fd.get('trimestral')),
        semestral: Number(fd.get('semestral'))
      };
      saveState();
      closeModal();
      renderApp();
      showToast('Regras de desconto atualizadas e mensalidades recalculadas!', 'success');
    };

    /* ============================================================================
       9. MÓDULO PERSONAL: AGENDA SEMANAL & PRESENÇA SEM CATRACA
       ============================================================================ */
    function renderPersonalSchedule(container) {
      container.innerHTML = `
        <div class="space-y-6">
          <!-- Topo da Agenda + Banner PIN Sem Catraca -->
          <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
            <div class="lg:col-span-2 rounded-2xl bg-sette-card border border-zinc-800/90 p-5 flex flex-col justify-between gap-4">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                <div>
                  <h2 class="text-2xl font-display font-bold text-white">Agenda Semanal & Presença</h2>
                  <p class="text-xs sm:text-sm text-zinc-400 mt-0.5">Travas automáticas: Individual (1/1 exclusivo) • Fight & Performance (máx. 4/4).</p>
                </div>
                <select onchange="setScheduleModalityFilter(this.value)" class="bg-zinc-950 border border-zinc-800 rounded-xl px-3 py-2 text-xs sm:text-sm text-zinc-200 focus:outline-none focus:border-emerald-500">
                  <option value="ALL" ${uiState.scheduleFilterModality === 'ALL' ? 'selected' : ''}>Todas Modalidades</option>
                  <option value="PERFORMANCE_SETTE" ${uiState.scheduleFilterModality === 'PERFORMANCE_SETTE' ? 'selected' : ''}>Performance Sette</option>
                  <option value="SETTE_FIGHT" ${uiState.scheduleFilterModality === 'SETTE_FIGHT' ? 'selected' : ''}>Sette Fight</option>
                  <option value="PERSONAL_INDIVIDUAL" ${uiState.scheduleFilterModality === 'PERSONAL_INDIVIDUAL' ? 'selected' : ''}>Personal Individual</option>
                </select>
              </div>
              <!-- Seletor de Dia da Semana -->
              <div class="grid grid-cols-3 sm:grid-cols-6 gap-2">
                ${DAYS_OF_WEEK.map(d => {
                  const count = appState.sessions.filter(s => s.dayOfWeek === d.id && s.status !== 'falta_justificada').length;
                  return `
                    <button onclick="selectScheduleDay(${d.id})" class="p-2.5 rounded-xl border text-center transition ${
                      uiState.selectedDay === d.id
                        ? 'bg-emerald-500 text-zinc-950 border-emerald-400 font-bold shadow-md'
                        : 'bg-zinc-950 text-zinc-300 border-zinc-800 hover:border-zinc-700'
                    }">
                      <span class="block text-xs sm:text-sm">${d.short}</span>
                      <span class="block text-[10px] mt-0.5 ${uiState.selectedDay === d.id ? 'text-zinc-900' : 'text-zinc-500'}">${count} aluno(s)</span>
                    </button>
                  `;
                }).join('')}
              </div>
            </div>

            <!-- Card compacto PIN & QR Code -->
            <div class="rounded-2xl bg-gradient-to-br from-zinc-900 to-zinc-950 border border-emerald-500/30 p-4 flex items-center gap-4">
              <div class="w-20 h-20 shrink-0 rounded-xl overflow-hidden">
                ${generateQrSvg('SETTE-' + appState.settings.dailyPin)}
              </div>
              <div class="flex-1 min-w-0">
                <span class="text-[10px] uppercase tracking-widest text-emerald-400 font-bold">PIN Check-in Hoje</span>
                <div class="font-display font-bold text-2xl tracking-[0.2em] text-white mt-0.5">${appState.settings.dailyPin}</div>
                <div class="flex items-center gap-1.5 mt-2">
                  <button onclick="copyText('${appState.settings.dailyPin}', 'PIN copiado!')" class="px-2 py-1 rounded-lg bg-zinc-800 hover:bg-zinc-700 text-[11px] text-zinc-200 transition">Copiar</button>
                  <button onclick="regenerateDailyPin()" class="px-2 py-1 rounded-lg bg-zinc-800 hover:bg-zinc-700 text-[11px] text-emerald-400 transition">Novo PIN</button>
                </div>
              </div>
            </div>
          </div>

          <!-- Lista de Slots (06:00 às 21:00) -->
          <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
            ${TIME_SLOTS.map(time => {
              const slot = analyzeSlot(uiState.selectedDay, time);
              if (uiState.scheduleFilterModality !== 'ALL' && slot.activeModality && slot.activeModality !== uiState.scheduleFilterModality) {
                return '';
              }
              const modInfo = slot.activeModality ? MODALITIES[slot.activeModality] : null;
              return `
                <div class="rounded-2xl bg-sette-card border ${slot.isExclusive ? 'border-white/30' : slot.isFull ? 'border-amber-500/40' : 'border-zinc-800/90'} p-4 flex flex-col justify-between">
                  <div>
                    <div class="flex items-center justify-between gap-2 pb-3 border-b border-zinc-800/80">
                      <div class="flex items-center gap-2.5">
                        <span class="font-display font-bold text-lg text-white">${time}</span>
                        ${modInfo
                          ? `<span class="px-2 py-0.5 rounded-full text-[10px] font-semibold border ${modInfo.badgeClass}">${modInfo.label}</span>`
                          : `<span class="px-2 py-0.5 rounded-full text-[10px] font-medium bg-zinc-900 text-zinc-500 border border-zinc-800">Horário Livre</span>`
                        }
                      </div>
                      <span class="text-xs font-bold ${slot.isExclusive ? 'text-white' : slot.isFull ? 'text-amber-400' : 'text-emerald-400'}">
                        ${slot.isExclusive ? '1/1 Exclusivo' : `${slot.occupied}/${slot.capacity}`}
                      </span>
                    </div>

                    <!-- Alunos no horário -->
                    <div class="mt-3 space-y-2">
                      ${slot.sessions.length === 0 ? `
                        <p class="text-xs text-zinc-500 py-4 text-center">Nenhuma reserva neste horário.</p>
                      ` : slot.sessions.map(ses => {
                        const st = getStudentById(ses.studentId);
                        if (!st) return '';
                        return `
                          <div class="p-2.5 rounded-xl bg-zinc-950/80 border border-zinc-800/80 space-y-2">
                            <div class="flex items-center justify-between gap-2">
                              <div class="flex items-center gap-2 min-w-0">
                                <div class="w-7 h-7 rounded-lg bg-zinc-800 text-[11px] font-bold text-emerald-400 flex items-center justify-center shrink-0">${getInitials(st.name)}</div>
                                <div class="min-w-0">
                                  <p class="text-xs font-semibold text-white truncate">${st.name}</p>
                                  <p class="text-[10px] text-zinc-500 truncate">${st.comboId ? (getComboById(st.comboId)?.name || '') : MODALITIES[st.modality].label}</p>
                                </div>
                              </div>
                              <button onclick="removeSession('${ses.id}')" title="Remover da aula" class="text-zinc-600 hover:text-rose-400 p-1">
                                <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                              </button>
                            </div>
                            <div class="grid grid-cols-3 gap-1">
                              <button onclick="updateSessionStatus('${ses.id}', 'presente')" class="py-1 rounded-lg text-[10px] font-semibold border transition ${
                                ses.status === 'presente'
                                  ? 'bg-emerald-500 text-zinc-950 border-emerald-400'
                                  : 'bg-zinc-900 text-zinc-400 border-zinc-800 hover:text-emerald-400'
                              }">✓ Presente</button>
                              <button onclick="updateSessionStatus('${ses.id}', 'falta_justificada')" class="py-1 rounded-lg text-[10px] font-semibold border transition ${
                                ses.status === 'falta_justificada'
                                  ? 'bg-amber-500 text-zinc-950 border-amber-400'
                                  : 'bg-zinc-900 text-zinc-400 border-zinc-800 hover:text-amber-400'
                              }">↺ Justif.</button>
                              <button onclick="updateSessionStatus('${ses.id}', 'no_show')" class="py-1 rounded-lg text-[10px] font-semibold border transition ${
                                ses.status === 'no_show'
                                  ? 'bg-rose-500 text-white border-rose-400'
                                  : 'bg-zinc-900 text-zinc-400 border-zinc-800 hover:text-rose-400'
                              }">✕ No-show</button>
                            </div>
                          </div>
                        `;
                      }).join('')}
                    </div>
                  </div>

                  <div class="mt-3 pt-3 border-t border-zinc-800/80">
                    ${slot.isFull ? `
                      <div class="w-full py-2 rounded-xl bg-zinc-900/70 text-center text-xs font-medium text-zinc-500 border border-zinc-800/70">
                        ${slot.isExclusive ? 'Bloqueado (Personal Exclusivo)' : 'Turma Lotada (4/4)'}
                      </div>
                    ` : `
                      <button onclick="openAddSessionModal(${uiState.selectedDay}, '${time}')" class="w-full py-2 rounded-xl bg-zinc-900 hover:bg-emerald-500 hover:text-zinc-950 text-zinc-300 border border-zinc-800 hover:border-emerald-400 text-xs font-semibold transition flex items-center justify-center gap-1.5">
                        <i data-lucide="plus" class="w-3.5 h-3.5"></i>
                        <span>Agendar Aluno</span>
                      </button>
                    `}
                  </div>
                </div>
              `;
            }).join('')}
          </div>
        </div>
      `;
    }

    window.selectScheduleDay = function (dayId) {
      uiState.selectedDay = dayId;
      renderApp();
    };

    window.setScheduleModalityFilter = function (mod) {
      uiState.scheduleFilterModality = mod;
      renderApp();
    };

    window.updateSessionStatus = function (sessionId, newStatus) {
      const ses = appState.sessions.find(s => s.id === sessionId);
      if (!ses) return;
      ses.status = ses.status === newStatus ? 'agendado' : newStatus;
      ses.checkinMethod = ses.status === 'agendado' ? null : 'manual';
      saveState();
      renderApp();
      const labels = {
        presente: 'Presença confirmada!',
        falta_justificada: 'Falta justificada — crédito devolvido ao aluno.',
        no_show: 'Falta (no-show) registrada — crédito consumido.',
        agendado: 'Status resetado para agendado.'
      };
      showToast(labels[ses.status], ses.status === 'no_show' ? 'warning' : 'success');
    };

    window.removeSession = function (sessionId) {
      appState.sessions = appState.sessions.filter(s => s.id !== sessionId);
      saveState();
      renderApp();
      showToast('Agendamento removido da grade.', 'info');
    };

    window.openAddSessionModal = function (dayOfWeek, time) {
      const slot = analyzeSlot(dayOfWeek, time);
      const candidates = appState.students.filter(s => s.status === 'ativo').map(s => {
        const check = canBookStudentInSlot(s.id, dayOfWeek, time);
        const credits = getStudentWeeklyCredits(s.id);
        return { student: s, check, credits };
      });

      openModal(`
        <div class="p-5 border-b border-zinc-800 flex items-center justify-between">
          <div>
            <h3 class="font-display font-bold text-lg text-white">Agendar em ${DAYS_OF_WEEK[dayOfWeek].full} às ${time}</h3>
            <p class="text-xs text-zinc-400">
              ${slot.activeModality ? `Modalidade ativa no horário: ${MODALITIES[slot.activeModality].label} (${slot.occupied}/${slot.capacity})` : 'Horário aberto para qualquer modalidade'}
            </p>
          </div>
          <button onclick="closeModal()" class="p-2 rounded-xl hover:bg-zinc-800 text-zinc-400"><i data-lucide="x" class="w-5 h-5"></i></button>
        </div>
        <div class="p-5 overflow-y-auto space-y-2.5 max-h-[65vh]">
          ${candidates.map(({ student, check, credits }) => `
            <div class="flex items-center justify-between gap-3 p-3 rounded-xl bg-zinc-950 border ${check.ok ? 'border-zinc-800 hover:border-emerald-500/40' : 'border-zinc-900 opacity-60'} transition">
              <div class="min-w-0">
                <div class="flex items-center gap-2">
                  <p class="text-sm font-semibold text-white truncate">${student.name}</p>
                  <span class="px-2 py-0.5 rounded-full text-[10px] border ${MODALITIES[student.modality].badgeClass}">${MODALITIES[student.modality].label}</span>
                </div>
                <p class="text-xs ${check.ok ? 'text-zinc-400' : 'text-rose-400'} mt-0.5">
                  ${check.ok ? `Créditos disponíveis: ${credits.remaining}/${credits.limit}` : check.reason}
                </p>
              </div>
              <button ${check.ok ? `onclick="confirmBookSession('${student.id}', ${dayOfWeek}, '${time}')"` : 'disabled'} class="px-3.5 py-2 rounded-xl text-xs font-bold shrink-0 transition ${
                check.ok ? 'bg-emerald-500 hover:bg-emerald-400 text-zinc-950' : 'bg-zinc-800 text-zinc-500 cursor-not-allowed'
              }">
                Agendar
              </button>
            </div>
          `).join('')}
        </div>
      `, 'max-w-lg');
    };

    window.confirmBookSession = function (studentId, dayOfWeek, time) {
      const check = canBookStudentInSlot(studentId, dayOfWeek, time);
      if (!check.ok) return showToast(check.reason, 'error');
      const st = getStudentById(studentId);
      appState.sessions.push({
        id: 'ses-' + Date.now(),
        dayOfWeek,
        time,
        studentId,
        modality: st.modality,
        status: 'agendado',
        checkinMethod: null
      });
      saveState();
      closeModal();
      renderApp();
      showToast(`${st.name} agendado(a) para ${DAYS_OF_WEEK[dayOfWeek].short} às ${time}!`, 'success');
    };

