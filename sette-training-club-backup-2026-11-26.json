            </div>
            <div class="flex flex-wrap items-center gap-2">
              <button onclick="openStudentModal()" class="flex items-center gap-2 px-4 py-2.5 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-zinc-950 font-semibold text-sm transition shadow-lg shadow-emerald-950/40">
                <i data-lucide="user-plus" class="w-4 h-4"></i>
                <span>Novo Aluno</span>
              </button>
              <button onclick="setPersonalTab('schedule')" class="flex items-center gap-2 px-4 py-2.5 rounded-xl bg-zinc-900 hover:bg-zinc-800 border border-zinc-800 text-zinc-100 font-medium text-sm transition">
                <i data-lucide="calendar-days" class="w-4 h-4 text-amber-400"></i>
                <span>Grade Semanal</span>
              </button>
            </div>
          </div>

          <!-- Grid de KPIs -->
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            <div class="p-5 rounded-2xl bg-sette-card border border-zinc-800/90 hover:border-zinc-700 transition">
              <div class="flex items-center justify-between">
                <span class="text-xs font-medium uppercase tracking-wider text-zinc-400">Alunos Ativos</span>
                <div class="w-9 h-9 rounded-xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center">
                  <i data-lucide="users" class="w-4 h-4"></i>
                </div>
              </div>
              <p class="text-3xl font-display font-bold text-white mt-3">${activeStudents.length}</p>
              <p class="text-xs text-zinc-400 mt-1">${appState.combos.length} combos vinculados ativos</p>
            </div>

            <div class="p-5 rounded-2xl bg-sette-card border border-zinc-800/90 hover:border-zinc-700 transition">
              <div class="flex items-center justify-between">
                <span class="text-xs font-medium uppercase tracking-wider text-zinc-400">MRR Estimado</span>
                <div class="w-9 h-9 rounded-xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center">
                  <i data-lucide="wallet" class="w-4 h-4"></i>
                </div>
              </div>
              <p class="text-3xl font-display font-bold text-emerald-400 mt-3">${formatBRL(totalMRR)}</p>
              <p class="text-xs text-zinc-400 mt-1">Receita mensal recorrente do portfólio</p>
            </div>

            <div class="p-5 rounded-2xl bg-sette-card border border-zinc-800/90 hover:border-zinc-700 transition">
              <div class="flex items-center justify-between">
                <span class="text-xs font-medium uppercase tracking-wider text-zinc-400">Assiduidade Média</span>
                <div class="w-9 h-9 rounded-xl bg-amber-500/10 text-amber-400 flex items-center justify-center">
                  <i data-lucide="flame" class="w-4 h-4"></i>
                </div>
              </div>
              <p class="text-3xl font-display font-bold text-white mt-3">${avgAttendance}%</p>
