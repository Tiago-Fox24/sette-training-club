                    : peersHere.length > 0
                      ? 'border-amber-500/50'
                      : 'border-zinc-800/90'
                } p-4 flex flex-col justify-between gap-3">
                  <div>
                    <div class="flex items-center justify-between gap-2">
                      <span class="font-display font-bold text-xl text-white">${time}</span>
