    /* Estilização complementar mínima para scrollbars, silhueta SVG e animações sutis */
    body {
      background-color: #09090b;
      color: #f4f4f5;
      overflow-x: hidden;
    }

    /* Scrollbar discreta */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: #09090b;
    }
    ::-webkit-scrollbar-thumb {
      background: #27272a;
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #3f3f46;
    }

    /* Interatividade da silhueta corporal anatômica */
    .body-segment {
      cursor: pointer;
      transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
      transform-origin: center;
    }
    .body-segment:hover {
      filter: brightness(1.25) drop-shadow(0 0 8px rgba(16, 185, 129, 0.45));
    }
    .body-segment.active-segment {
      stroke: #ffffff !important;
      stroke-width: 2.5px !important;
      filter: drop-shadow(0 0 12px rgba(16, 185, 129, 0.7));
    }

    /* Animação suave para toasts */
    @keyframes slideInRight {
      from { transform: translateX(100%); opacity: 0; }
      to { transform: translateX(0); opacity: 1; }
    }
    .toast-enter {
      animation: slideInRight 0.25s ease-out forwards;
    }

    /* Esconder scrollbar em menus horizontais mobile */
    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .no-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
