                  ${comboAlerts.length === 0 && churnRisks.length === 0 ? `
                    <div class="p-4 rounded-xl bg-emerald-500/10 border border-emerald-500/20 text-center">
                      <p class="text-xs text-emerald-300 font-medium">Tudo sob controle! Nenhum alerta crítico no momento.</p>
                    </div>
                  ` : ''}
                </div>
