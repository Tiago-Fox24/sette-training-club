                          : check.reason
                      }
                    </p>
                  </div>

                  <div>
                    ${mySessionHere ? (
                      mySessionHere.status === 'agendado'
                        ? `<button onclick="studentCancelSession('${mySessionHere.id}')" class="w-full py-2.5 rounded-xl bg-zinc-900 hover:bg-rose-500/20 border border-zinc-700 hover:border-rose-500/40 text-xs font-semibold text-zinc-200 hover:text-rose-300 transition">Cancelar Reserva (Devolver Crédito)</button>`
                        : `<div class="w-full py-2 rounded-xl bg-emerald-500/10 text-emerald-400 text-center text-xs font-semibold border border-emerald-500/20">✓ Treino Realizado</div>`
                    ) : check.ok ? `
                      <button onclick="studentBookSlot(${uiState.selectedDay}, '${time}')" class="w-full py-2.5 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-zinc-950 font-bold text-xs transition">
